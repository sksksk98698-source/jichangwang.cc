---
import { PORTFOLIO_DATA } from "../data/portfolio";
import { AIRPORTS_DATA, TOP10_AIRPORTS, FEATURED_AIRPORT } from "../data/airports";
import Neofetch from "./Neofetch.astro";

const { developer } = PORTFOLIO_DATA;
---

<div
  id="view-gui"
  class="flex flex-col space-y-8 font-mono text-xs md:text-sm text-[var(--fg-main)]"
>
  <!-- 顶部系统雷达指标摘要面板 -->
  <Neofetch />

  <!-- 主 TUI 栅格：侧边栏快速锚点导航 + 主视窗核心深度评测专著 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- 侧边栏导航面板 (在桌面端粘性悬浮，移动端自适应平铺) -->
    <aside
      class="lg:col-span-3 border border-[var(--border-color)] bg-[var(--bg-card)] p-4 space-y-4 self-start lg:sticky lg:top-4"
    >
      <div
        class="text-[var(--accent)] font-bold border-b border-[var(--border-color)] pb-2 flex items-center justify-between"
      >
        <span>📁 智库核心导航</span>
        <span class="text-[10px] text-[var(--fg-dim)]">TOC / 专著目录</span>
      </div>

      <nav class="space-y-1.5 font-mono text-xs">
        <a
          href="#direct-verdict"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-amber-300 font-bold transition-colors"
        >
          <span>⚡</span> 01_极速选购结论与结论速览
        </a>
        <a
          href="#matrix-table"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold transition-colors"
        >
          <span>📊</span> 02_42家机场核心对比天梯表
        </a>
        <a
          href="#deep-guangsu"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--accent)] font-bold transition-colors"
        >
          <span>🏆</span> 03_第一主推【光速云】深度实测
        </a>
        <a
          href="#tier-analysis"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold transition-colors"
        >
          <span>🥈</span> 04_全网主力梯队品牌横向横评
        </a>
        <a
          href="#tech-principles"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-cyan-300 font-bold transition-colors"
        >
          <span>🔬</span> 05_网络拓扑与传输协议原理解析
        </a>
        <a
          href="#performance-tuning"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-emerald-400 font-bold transition-colors"
        >
          <span>⚙️</span> 06_MTU与DNS防污染深度调优
        </a>
        <a
          href="#rules-engine"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-cyan-300 font-bold transition-colors"
        >
          <span>🧩</span> 07_AI与流媒体精准分流配置
        </a>
        <a
          href="#brands-atlas"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-amber-300 font-bold transition-colors"
        >
          <span>🗺️</span> 08_42家机场全景选型图谱
        </a>
        <a
          href="#decision-tree"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-emerald-300 font-bold transition-colors"
        >
          <span>🧭</span> 09_多场景决策与五大终端上手
        </a>
        <a
          href="#faq-section"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-yellow-300 font-bold transition-colors"
        >
          <span>🛡️</span> 10_安全合规与防关联指南
        </a>
        <a
          href="#faq-section"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-yellow-300 font-bold transition-colors"
        >
          <span>❓</span> 11_实战高频问题与风控FAQ
        </a>
        <a
          href="#conversion-cta"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-red-400 font-bold transition-colors"
        >
          <span>🎁</span> 12_专属特惠与安全核实入口
        </a>
      </nav>

      <!-- 快速切换到 CLI 终端模式按钮 -->
      <div class="pt-4 border-t border-[var(--border-color)] space-y-2">
        <button
          onclick="window.switchTuiMode('cli')"
          class="w-full text-center py-2 px-3 border border-[var(--accent)] bg-[var(--bg-main)] text-[var(--accent)] hover:bg-[var(--accent)] hover:text-black font-bold transition-colors cursor-pointer"
        >
          >_ 切换为黑客终端模式 (CLI)
        </button>
        <p class="text-[11px] text-[var(--fg-dim)] text-center">
          在终端键入 help / top10 / guangsu 体验命令行交互
        </p>
      </div>

      <!-- 站内延伸专栏快速通道 -->
      <div class="pt-3 border-t border-[var(--border-color)]">
        <div class="text-[11px] text-[var(--fg-dim)] uppercase tracking-wider mb-2 font-bold">
          🔗 站内延伸专栏
        </div>
        <div class="grid grid-cols-2 gap-1 text-[11px]">
          <a href="/brands" class="p-1 border border-[var(--border-color)] hover:border-[var(--accent)] text-center text-[var(--fg-bright)]">
            42家品牌库
          </a>
          <a href="/speedtest" class="p-1 border border-[var(--border-color)] hover:border-[var(--accent)] text-center text-[var(--fg-bright)]">
            晚高峰测速库
          </a>
          <a href="/clients" class="p-1 border border-[var(--border-color)] hover:border-[var(--accent)] text-center text-[var(--fg-bright)]">
            客户端教程
          </a>
          <a href="/geo" class="p-1 border border-[var(--border-color)] hover:border-[var(--accent)] text-center text-[var(--fg-bright)]">
            GEO出海专线
          </a>
        </div>
      </div>
    </aside>

    <!-- 主视窗专著级深度正文内容 -->
    <main class="lg:col-span-9 space-y-10">

      <!-- ==========================================
           第一模块：开头直接提供答案与选购速决结论
      ========================================== -->
      <section
        id="direct-verdict"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-6 space-y-5"
      >
        <div class="border-b border-[var(--border-color)] pb-3 flex items-center justify-between">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>⚡</span> 01 / 极速选购结论：2026年专线机场综合推荐与避坑法则
          </h2>
          <span class="text-[10px] px-2 py-0.5 border border-amber-400/40 text-amber-300 bg-amber-950/20">
            2026年3月最新核实
          </span>
        </div>

        <p class="text-xs md:text-sm leading-relaxed text-[var(--fg-bright)]">
          如果您没有充裕的时间研读数万字的网络协议底层原理与机房拓扑报告，只想在五分钟内获得一个<strong>绝不踩坑、晚高峰不卡顿、IP绝对干净、且性价比极高</strong>的最终决策，我们的专业实测实验室基于对全网 42 家主流机场长达数月的持续压测，给出以下最直接明确的选购答案：
        </p>

        <!-- 极速选型卡片网格 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- 核心第一主推卡片 -->
          <div class="border-2 border-[var(--accent)] bg-[var(--bg-main)] p-4 space-y-3 relative">
            <div class="absolute -top-3 right-3 bg-[var(--accent)] text-black text-[10px] font-bold px-2 py-0.5">
              全网综合榜首 NO.1
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xl">🏆</span>
              <div>
                <h3 class="text-sm font-bold text-[var(--accent)]">光速云 (Guangsu Cloud)</h3>
                <p class="text-[11px] text-[var(--fg-dim)]">企业级内网双专线架构 // 2020年起稳定运营逾6年</p>
              </div>
            </div>
            <p class="text-xs text-[var(--fg-main)] leading-relaxed">
              <strong>为什么是第一主推：</strong>全网绝无仅有的“致敬斯诺克147永久套餐”（147元一次性买断247GB永久有效，永不过期），彻底解决传统按月付费月底清零的焦虑；同时提供年付折合仅8元/月的轻量款，全节点最高支持2.5Gbps物理带宽，晚高峰4K秒开，原生住宅IP让ChatGPT/Claude零封号。
            </p>
            <div class="bg-[var(--bg-card)] p-2.5 border border-[var(--border-color)] space-y-1.5 text-xs">
              <div class="flex justify-between">
                <span class="text-[var(--fg-dim)]">入门特惠：</span>
                <span class="text-emerald-400 font-bold">折合 8.25 元/月 (99元/年，每月69GB)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--fg-dim)]">永久套餐：</span>
                <span class="text-amber-300 font-bold">147 元买断 247GB (无有效期限永不清零)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--fg-dim)]">专属优惠码：</span>
                <span class="text-[var(--accent)] font-bold tracking-widest bg-black px-1.5 border border-[var(--accent)]">AMM</span>
              </div>
            </div>
            <div class="pt-1 flex gap-2">
              <a
                href="https://gsy01.vip/#/register?code=wY5yvR82"
                target="_blank"
                rel="nofollow sponsored noopener"
                class="flex-1 text-center py-2 bg-[var(--accent)] text-black font-bold hover:brightness-110 transition-all text-xs"
              >
                前往光速云官网选购 →
              </a>
              <a
                href="#deep-guangsu"
                class="px-3 py-2 border border-[var(--border-color)] hover:border-[var(--accent)] text-center text-xs text-[var(--fg-bright)]"
              >
                查看实测大图
              </a>
            </div>
          </div>

          <!-- 第二梯队差异化备选卡片 -->
          <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-4 space-y-3">
            <div class="text-[11px] text-[var(--fg-dim)] font-bold uppercase tracking-wider">
              ⚡ 差异化场景优选备选
            </div>
            <ul class="space-y-3 text-xs">
              <li class="border-b border-[var(--border-color)] pb-2">
                <div class="flex justify-between font-bold text-[var(--fg-bright)]">
                  <span>🥈 电竞低延迟首选：暮光加速</span>
                  <span class="text-amber-400">15 元/月起</span>
                </div>
                <p class="text-[11px] text-[var(--fg-dim)] mt-1">
                  主打超低延迟 IEPL 电竞专线，香港/日本节点物理延迟稳定在 30ms 左右，全节点倍率透明。
                </p>
              </li>
              <li class="border-b border-[var(--border-color)] pb-2">
                <div class="flex justify-between font-bold text-[var(--fg-bright)]">
                  <span>🥉 全家大流量刷剧：飞猫云</span>
                  <span class="text-amber-400">12 元/月起</span>
                </div>
                <p class="text-[11px] text-[var(--fg-dim)] mt-1">
                  BGP 多入口多线容灾，设备数限制极度宽松，适合多台电视盒子与全家高码率 Netflix 串流。
                </p>
              </li>
              <li>
                <div class="flex justify-between font-bold text-[var(--fg-bright)]">
                  <span>🌐 跨国业务独立定制：光速云定制版</span>
                  <span class="text-cyan-400">680 元/月</span>
                </div>
                <p class="text-[11px] text-[var(--fg-dim)] mt-1">
                  一对一线下开通，独享原生机房与独立出口带宽，专为 TikTok 海外直播、跨境电商高风险账号打造。
                </p>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-3 bg-[var(--bg-main)] border-l-4 border-amber-400 text-xs text-[var(--fg-dim)] leading-relaxed">
          <strong class="text-amber-300">编辑部选购铁律提醒：</strong>
          切勿因贪图小便宜购买所谓的“5元/年”、“10元/年”的月抛型超低价小作坊。这类服务商往往采用公网单跳直连甚至滥用云厂商免费试用配额，一旦遇到国际出口高峰期丢包率高达 40% 以上，且通常在运行 2 至 3 个月后突然卷款跑路。选择运营 3 年以上、拥有正规内网专线物理过境资质的服务商，才是保护个人数据与时间成本的核心防线。
        </div>
      </section>

      <!-- ==========================================
           第二模块：42家机场核心对比天梯表
      ========================================== -->
      <section
        id="matrix-table"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-6 space-y-4"
      >
        <div class="border-b border-[var(--border-color)] pb-3 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-base md:text-lg font-bold text-[var(--fg-bright)] flex items-center gap-2">
              <span>📊</span> 02 / 42家主流机场核心对比天梯表（2026实测基准版）
            </h2>
            <p class="text-xs text-[var(--fg-dim)] mt-1">
              包含价格周期折算、线路架构、节点倍率、原生IP流媒体解锁及适用场景全维度比对
            </p>
          </div>
          <span class="text-[10px] text-[var(--fg-dim)] border border-[var(--border-color)] px-2 py-1">
            横向滚动查看完整参数 →
          </span>
        </div>

        <p class="text-xs md:text-sm leading-relaxed text-[var(--fg-main)]">
          为了消除不同服务商在套餐周期计算、计量倍率与隐藏限制上的信息不对称，我们统一按照<strong>“实测月费最低门槛、年付折合单月价格、实际可用月流量、全节点最高倍率、并发设备上限与核心过境线路”</strong>六大硬性指标重新核算。以下为前十大代表性品牌与主力梯队的横向对照表：
        </p>

        <!-- 响应式表格外容器 (支持局部平滑水平滚动，保证移动端 375px 不溢出) -->
        <div class="overflow-x-auto border border-[var(--border-color)] bg-[var(--bg-main)] scrollbar-thin">
          <table class="w-full text-left border-collapse text-xs whitespace-nowrap min-w-[950px]">
            <thead>
              <tr class="bg-[var(--status-bar-bg)] border-b border-[var(--border-color)] text-[var(--fg-bright)]">
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">梯队排名</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">品牌名称</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">实测最低月费</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">年付折算单价</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">基准月流量</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">倍率区间</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">设备限制</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">核心线路</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">主流协议</th>
                <th class="p-2.5 font-bold border-r border-[var(--border-color)]">原生AI/流媒体</th>
                <th class="p-2.5 font-bold">资料来源与核实</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-color)] font-mono">
              <!-- #1 光速云 -->
              <tr class="bg-amber-950/20 hover:bg-amber-900/30 transition-colors">
                <td class="p-2.5 font-bold text-amber-300 border-r border-[var(--border-color)]">TOP 1 (主推)</td>
                <td class="p-2.5 font-bold text-[var(--accent)] border-r border-[var(--border-color)]">
                  <a href="#deep-guangsu" class="underline hover:brightness-120">光速云.vip</a>
                </td>
                <td class="p-2.5 text-emerald-400 font-bold border-r border-[var(--border-color)]">8.25 元/月</td>
                <td class="p-2.5 text-emerald-400 font-bold border-r border-[var(--border-color)]">8.25 元/月 (99元/年)</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">69GB/月 或 247GB永久</td>
                <td class="p-2.5 text-cyan-300 border-r border-[var(--border-color)]">全节点 ×1.0</td>
                <td class="p-2.5 text-emerald-400 font-bold border-r border-[var(--border-color)]">不限设备</td>
                <td class="p-2.5 text-amber-300 border-r border-[var(--border-color)]">IEPL+企业内网专线</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">VLESS / Trojan / SS</td>
                <td class="p-2.5 text-emerald-400 font-bold border-r border-[var(--border-color)]">全绿解锁 (ChatGPT/Claude)</td>
                <td class="p-2.5 text-[var(--fg-dim)]">2026-03 实测控制台</td>
              </tr>

              <!-- #2 暮光加速 -->
              <tr class="hover:bg-[var(--bg-card)] transition-colors">
                <td class="p-2.5 font-bold text-[var(--fg-bright)] border-r border-[var(--border-color)]">TOP 2</td>
                <td class="p-2.5 font-bold text-[var(--fg-bright)] border-r border-[var(--border-color)]">暮光加速</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">15.00 元/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">12.50 元/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">100GB/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">×1.0 ~ ×1.5</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">限制 3 设备</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">IEPL 专线</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">Trojan / SS</td>
                <td class="p-2.5 text-emerald-400 border-r border-[var(--border-color)]">支持主流流媒体</td>
                <td class="p-2.5 text-[var(--fg-dim)]">2026-02 官网清单</td>
              </tr>

              <!-- #3 飞猫云 -->
              <tr class="hover:bg-[var(--bg-card)] transition-colors">
                <td class="p-2.5 font-bold text-[var(--fg-bright)] border-r border-[var(--border-color)]">TOP 3</td>
                <td class="p-2.5 font-bold text-[var(--fg-bright)] border-r border-[var(--border-color)]">飞猫云</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">12.00 元/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">10.00 元/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">120GB/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">×0.8 ~ ×2.0</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">限制 5 设备</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">BGP 入口 + IEPL</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">Shadowsocks</td>
                <td class="p-2.5 text-emerald-400 border-r border-[var(--border-color)]">4K Netflix / YT</td>
                <td class="p-2.5 text-[var(--fg-dim)]">2026-03 晚高峰实测</td>
              </tr>

              <!-- #4 微风网络 -->
              <tr class="hover:bg-[var(--bg-card)] transition-colors">
                <td class="p-2.5 font-bold text-[var(--fg-bright)] border-r border-[var(--border-color)]">TOP 4</td>
                <td class="p-2.5 font-bold text-[var(--fg-bright)] border-r border-[var(--border-color)]">微风网络</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">18.00 元/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">15.00 元/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">150GB/月</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">×1.0</td>
                <td class="p-2.5 border-r border-[var(--border-color)]">限制 4 设备</td>
