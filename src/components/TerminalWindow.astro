---
import { ALL_THEMES } from "../config/themeConfig";
import { PORTFOLIO_DATA } from "../data/portfolio";

interface Props {
  currentPath?: string;
  showModeTabs?: boolean;
}

const { currentPath = "~/jichangwang", showModeTabs = true } = Astro.props;
---

<div
  class="max-w-6xl mx-auto w-full border border-[var(--border-active)] bg-[var(--bg-main)] shadow-2xl relative transition-all duration-200"
>
  <header
    class="bg-[var(--status-bar-bg)] border-b border-[var(--border-color)] px-3 py-2 flex flex-wrap items-center justify-between gap-2 select-none"
  >
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5">
        <span
          id="win-close"
          title="Reset Terminal"
          class="w-3 h-3 rounded-full bg-red-500/80 hover:bg-red-500 cursor-pointer inline-block border border-red-700 transition-colors"
        ></span>
        <span
          id="win-min"
          title="Toggle Compact View"
          class="w-3 h-3 rounded-full bg-yellow-500/80 hover:bg-yellow-500 cursor-pointer inline-block border border-yellow-700 transition-colors"
        ></span>
        <span
          id="win-max"
          title="Full Width"
          class="w-3 h-3 rounded-full bg-emerald-500/80 hover:bg-emerald-500 cursor-pointer inline-block border border-emerald-700 transition-colors"
        ></span>
      </div>
      <div
        class="text-xs font-mono font-bold text-[var(--fg-bright)] flex items-center gap-1.5"
      >
        <span class="text-[var(--fg-dim)]">radar@jichangwang.cc:</span>
        <span id="current-path" class="text-[var(--accent)] font-mono"
          >{currentPath}</span
        >
        <span
          class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--border-color)] text-emerald-400 font-mono"
          >42_BRANDS_ONLINE*</span
        >
      </div>
    </div>

    {showModeTabs && (
      <div
        class="flex items-center gap-1 bg-[var(--bg-card)] border border-[var(--border-color)] p-0.5 rounded-none text-xs font-mono"
      >
        <button
          id="tab-cli"
          class="hidden md:inline-block px-3 py-1 font-bold text-[var(--fg-bright)] bg-[var(--border-color)] border-b-2 border-[var(--accent)] cursor-pointer transition-colors"
        >
          >_ CLI Mode
        </button>
        <button
          id="tab-gui"
          class="px-3 py-1 font-bold text-[var(--fg-dim)] hover:text-[var(--fg-bright)] cursor-pointer transition-colors"
        >
          [#] GUI Dashboard
        </button>
      </div>
    )}

    <div class="flex items-center gap-2 text-xs font-mono">
      <div class="relative group">
        <select
          id="theme-select"
          aria-label="Select Color Theme"
          class="bg-[var(--bg-card)] text-[var(--fg-bright)] border border-[var(--border-color)] px-2 py-1 text-xs font-mono cursor-pointer focus:outline-none focus:border-[var(--border-active)]"
        >
          {
            ALL_THEMES.map((theme) => (
              <option value={theme.id}>
                {theme.emoji} {theme.name}
              </option>
            ))
          }
        </select>
      </div>

      <button
        id="toggle-crt-btn"
        aria-label="Toggle CRT Effect"
        class="hidden md:flex px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--border-active)] text-[var(--fg-bright)] cursor-pointer items-center gap-1"
      >
        <span id="crt-indicator" class="w-2 h-2 rounded-full bg-emerald-400"
        ></span>
        <span class="hidden sm:inline">CRT</span>
      </button>

      <button
        id="toggle-sfx-btn"
        aria-label="Toggle Audio Sound Effects"
        class="px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--border-active)] text-[var(--fg-bright)] cursor-pointer flex items-center gap-1"
      >
        <span id="sfx-icon">🔊</span>
        <span id="sfx-status" class="hidden sm:inline">SFX</span>
      </button>

      <button
        id="trigger-radio-btn"
        title="Open Retro Lo-Fi & Chiptune Radio Player"
        class="hidden sm:flex px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent)] text-[var(--accent)] font-bold cursor-pointer items-center gap-1"
      >
        <span>📻</span> <span class="hidden md:inline">Radio</span>
      </button>

      <button
        id="trigger-pong-btn"
        title="Play Retro Pong Arcade Game"
        class="hidden sm:flex px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent)] text-[var(--accent)] font-bold cursor-pointer items-center gap-1"
      >
        <span>🕹️</span> <span class="hidden md:inline">Pong</span>
      </button>

      <button
        id="trigger-snake-btn"
        title="Play Retro Snake Arcade Game"
        class="hidden sm:flex px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent)] text-[var(--accent)] font-bold cursor-pointer items-center gap-1"
      >
        <span>🐍</span> <span class="hidden md:inline">Snake</span>
      </button>

      <button
        id="trigger-matrix-btn"
        title="Trigger Matrix Rain"
        class="px-2 py-1 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--accent)] text-[var(--accent)] font-bold cursor-pointer"
      >
        ⚡ Matrix
      </button>
    </div>
  </header>

  <!-- 机场网 SEO 与 GEO 核心导航枢纽栏 (Topic Cluster Hub) -->
  <nav
    aria-label="机场网核心导航"
    class="bg-[var(--bg-card)] border-b border-[var(--border-color)] px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-xs font-mono select-none"
  >
    <div class="flex items-center flex-wrap gap-1.5 overflow-x-auto scrollbar-thin">
      <span class="text-[var(--accent)] font-bold mr-1">RADAR://</span>
      <a
        href="/"
        class="px-2 py-0.5 border border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--accent)] text-[var(--fg-bright)] hover:text-[var(--accent)] transition-colors font-bold"
      >
        01.智库首页
      </a>
      <a
        href="/brands"
        class="px-2 py-0.5 border border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--accent)] text-[var(--fg-bright)] hover:text-[var(--accent)] transition-colors font-bold"
      >
        02.42家品牌库
      </a>
      <a
        href="/free"
        class="px-2 py-0.5 border border-amber-400/40 bg-[var(--bg-main)] hover:border-amber-400 text-amber-300 font-bold hover:brightness-120 transition-colors"
      >
        03.免费资源
      </a>
      <a
        href="/clients"
        class="px-2 py-0.5 border border-cyan-400/40 bg-[var(--bg-main)] hover:border-cyan-400 text-cyan-300 font-bold hover:brightness-120 transition-colors"
      >
        04.梯子工具
      </a>
      <a
        href="/faq"
        class="px-2 py-0.5 border border-yellow-400/40 bg-[var(--bg-main)] hover:border-yellow-400 text-yellow-300 font-bold hover:brightness-120 transition-colors"
      >
        05.机场FAQ
      </a>
      <a
        href="/alerts"
        class="px-2 py-0.5 border border-red-400/40 bg-[var(--bg-main)] hover:border-red-400 text-red-400 font-bold hover:brightness-120 transition-colors"
      >
        06.跑路预警
      </a>
      <a
        href="/speedtest"
        class="px-2 py-0.5 border border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--accent)] text-[var(--fg-bright)] hover:text-[var(--accent)] transition-colors font-bold"
      >
        07.晚高峰测速
      </a>
      <a
        href="/geo"
        class="px-2 py-0.5 border border-emerald-400/40 bg-[var(--bg-main)] hover:border-emerald-400 text-emerald-400 font-bold hover:brightness-120 transition-colors"
      >
        08.出海专线
      </a>
    </div>

    <!-- 主推高转化金标提示 -->
    <div class="hidden lg:flex items-center gap-2 text-xs font-mono bg-yellow-500/10 border border-yellow-500/30 px-2 py-0.5">
      <span class="text-amber-400 font-bold">🏆 镇站首推: 光速云</span>
      <span class="text-[var(--fg-dim)]">双专线/8元起</span>
      <a
        href="https://gsy01.vip/#/register?code=wY5yvR82"
        target="_blank"
        rel="nofollow sponsored noopener"
        class="text-emerald-400 hover:text-emerald-300 font-bold underline"
      >
        直达 [码:AMM] ↗
      </a>
    </div>
  </nav>

  <main class="p-4 md:p-6 min-h-[650px] flex flex-col justify-between">
    <slot />
  </main>

  <footer
    class="bg-[var(--status-bar-bg)] border-t border-[var(--border-color)] px-4 py-1.5 text-[11px] font-mono text-[var(--fg-dim)] flex flex-wrap items-center justify-between gap-2 select-none"
  >
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-emerald-400 font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        STATUS 200 OK // RADAR ONLINE
      </span>
      <span class="hidden sm:inline">UTF-8</span>
      <span class="hidden md:inline"
        >42 BRANDS MONITORED</span
      >
      <span class="text-[var(--border-color)]">|</span>
      <a href="/about" class="hover:text-[var(--accent)] underline">关于实验室</a>
      <a href="/disclaimer" class="hover:text-[var(--accent)] underline">免责声明</a>
    </div>

    <!-- Live Status Bar Radio Ticker -->
    <div
      id="status-radio-ticker"
      title="Click to toggle Lo-Fi Radio Player"
      class="hidden md:flex items-center gap-2 cursor-pointer text-[var(--fg-bright)] hover:text-[var(--accent)] transition-colors px-2 py-0.5 border border-transparent hover:border-[var(--border-color)]"
    >
      <span id="status-radio-icon">📻</span>
      <span id="status-radio-title" class="truncate max-w-[180px]">RADIO: OFF</span>
      <span id="status-radio-meter" class="text-[var(--accent)] font-mono font-bold"></span>
    </div>

    <div class="flex items-center gap-4">
      <span id="live-clock" class="text-[var(--fg-bright)] font-mono"
        >00:00:00 UTC</span
      >
      <span class="text-[var(--accent)] font-bold">JICHANGWANG_ENGINE v6.0</span>
    </div>
  </footer>
</div>

<script>
  import {
    toggleSfx,
    isSfxEnabled,
    initSfxFromStorage,
    playBeep,
  } from "../utils/sound";
  import { applyTheme, applyCRTConfig } from '../config/themeConfig';

  // 全局 TUI 双模式切换引擎 (CLI 终端模式 / GUI 图形仪表盘模式)
  window.switchTuiMode = function(mode: 'cli' | 'gui') {
    const cliView = document.getElementById("view-cli");
    const guiView = document.getElementById("view-gui");
    const cliTab = document.getElementById("tab-cli");
    const guiTab = document.getElementById("tab-gui");

    if (mode === 'gui') {
      if (cliView) cliView.classList.add("hidden");
      if (guiView) guiView.classList.remove("hidden");
      if (cliTab) {
        cliTab.classList.remove("bg-[var(--border-color)]", "text-[var(--fg-bright)]", "border-b-2", "border-[var(--accent)]");
        cliTab.classList.add("text-[var(--fg-dim)]");
      }
      if (guiTab) {
        guiTab.classList.remove("text-[var(--fg-dim)]");
        guiTab.classList.add("bg-[var(--border-color)]", "text-[var(--fg-bright)]", "border-b-2", "border-[var(--accent)]");
      }
      localStorage.setItem("tui_view_mode", "gui");
      playBeep(700, 0.04);
    } else {
      if (guiView) guiView.classList.add("hidden");
      if (cliView) cliView.classList.remove("hidden");
      if (guiTab) {
        guiTab.classList.remove("bg-[var(--border-color)]", "text-[var(--fg-bright)]", "border-b-2", "border-[var(--accent)]");
        guiTab.classList.add("text-[var(--fg-dim)]");
      }
      if (cliTab) {
        cliTab.classList.remove("text-[var(--fg-dim)]");
        cliTab.classList.add("bg-[var(--border-color)]", "text-[var(--fg-bright)]", "border-b-2", "border-[var(--accent)]");
      }
      localStorage.setItem("tui_view_mode", "cli");
      playBeep(520, 0.04);
      // 聚焦终端输入框
      const input = document.getElementById("cli-input") as HTMLInputElement;
      if (input) input.focus();
    }
  };

  document.addEventListener("DOMContentLoaded", () => {
    initSfxFromStorage();
    updateSfxUI();

    // 绑定 Tab 点击事件
    const cliTab = document.getElementById("tab-cli");
    const guiTab = document.getElementById("tab-gui");
    cliTab?.addEventListener("click", () => window.switchTuiMode('cli'));
    guiTab?.addEventListener("click", () => window.switchTuiMode('gui'));

    // 检查 URL Hash 或缓存首选模式 (如果有 #gui 或 #view-gui 或移动端，默认切 GUI)
    const hash = window.location.hash;
    const savedMode = localStorage.getItem("tui_view_mode");
    if (hash.includes("gui") || hash.includes("table") || hash.includes("guangsu") || savedMode === "gui" || window.innerWidth < 768) {
      window.switchTuiMode('gui');
    }

    function updateClock() {
      const clockEl = document.getElementById("live-clock");
      if (clockEl) {
        const now = new Date();
        clockEl.textContent = now.toTimeString().split(" ")[0] + " BJT";
      }
    }
    updateClock();
    setInterval(updateClock, 1000);

    const themeSelect = document.getElementById(
      "theme-select",
    ) as HTMLSelectElement;
    const savedTheme = localStorage.getItem("tui_theme") || "green";
    if (themeSelect) {
      themeSelect.value = savedTheme;
      applyTheme(savedTheme);

      themeSelect.addEventListener("change", (e) => {
        const val = (e.target as HTMLSelectElement).value;
        applyTheme(val);
        localStorage.setItem("tui_theme", val);
        playBeep(600, 0.05);
      });
    }

    const crtBtn = document.getElementById("toggle-crt-btn");
    applyCRTConfig();

    crtBtn?.addEventListener("click", () => {
      const currentOpacity = getComputedStyle(document.documentElement).getPropertyValue("--scanline-opacity").trim();
      const currentlyOn = currentOpacity !== "0" && currentOpacity !== "";
      applyCRTConfig({ enabled: !currentlyOn });
      playBeep(450, 0.04);
    });

    const sfxBtn = document.getElementById("toggle-sfx-btn");
    sfxBtn?.addEventListener("click", () => {
      toggleSfx();
      updateSfxUI();
    });

    function updateSfxUI() {
      const enabled = isSfxEnabled();
      const sfxIcon = document.getElementById("sfx-icon");
      const sfxStatus = document.getElementById("sfx-status");
      if (sfxIcon) sfxIcon.textContent = enabled ? "🔊" : "🔇";
      if (sfxStatus) sfxStatus.textContent = enabled ? "SFX ON" : "SFX OFF";
    }

    document
      .getElementById("trigger-radio-btn")
      ?.addEventListener("click", () => {
        const win = window as unknown as {
          radioEngine?: { toggleModal: (f?: boolean) => void };
        };
        if (win.radioEngine) {
          win.radioEngine.toggleModal(true);
          playBeep(750, 0.05);
        }
      });
  });
</script>
