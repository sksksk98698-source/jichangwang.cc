---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import { AIRPORTS_DATA, type AirportBrand } from "../../data/airports";
import { SITE_CONFIG } from "../../config/siteConfig";

export async function getStaticPaths() {
  return AIRPORTS_DATA.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;

const pageTitle = `${brand.name}测评与晚高峰测速 // ${brand.lineType} // 机场网 JichangWang.cc`;
const pageDesc = `${brand.name}怎么样？2026年最新深度评测：${brand.tagline}。线路架构：${brand.lineType}，入门特惠${brand.entryPrice}，专属优惠码${brand.coupon}。包含晚高峰节点测速大图、流媒体4K与ChatGPT/Claude解锁实测报告。`;

// 规范结构化数据 (Schema.org Product & Review & BreadcrumbList)
const canonicalUrl = `${SITE_CONFIG.siteUrl}/brands/${brand.slug}`;
const schemaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "机场网首页",
          "item": SITE_CONFIG.siteUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "42家机场品牌库",
          "item": `${SITE_CONFIG.siteUrl}/brands`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${brand.name} 深度测评`,
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Product",
      "name": `${brand.name} 网络加速服务`,
      "description": brand.summary,
      "image": brand.speedtestImage ? `${SITE_CONFIG.siteUrl}${brand.speedtestImage}` : `${SITE_CONFIG.siteUrl}/favicon.svg`,
      "brand": {
        "@type": "Brand",
        "name": brand.name
      },
      "offers": {
        "@type": "Offer",
        "price": brand.minMonthlyPrice,
        "priceCurrency": "CNY",
        "availability": "https://schema.org/InStock",
        "url": brand.affLink
      },
      "review": {
        "@type": "Review",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": brand.isFeatured ? "9.8" : brand.isTop10 ? "9.4" : "8.7",
          "bestRating": "10"
        },
        "author": {
          "@type": "Organization",
          "name": "机场网实测实验室"
        },
        "reviewBody": brand.summary
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  image={brand.speedtestImage || "/favicon.svg"}
  keywords={[
    `${brand.name}`,
    `${brand.name}测评`,
    `${brand.name}怎么样`,
    `${brand.name}优惠码`,
    `${brand.name}测速`,
    `${brand.name}官网`,
    `${brand.lineType}`,
    "机场推荐"
  ]}
>
  <!-- SEO 结构化数据插入 -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} slot="head" />

  <h1 class="sr-only">{pageTitle}</h1>

  <TerminalWindow currentPath={`~/jichangwang/brands/${brand.slug}`} showModeTabs={false}>
    <div class="space-y-6 font-mono text-xs md:text-sm select-text">
      <!-- 面包屑导航与排名概览 -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3">
        <nav aria-label="面包屑" class="flex items-center gap-1.5 text-xs text-[var(--fg-dim)]">
          <a href="/" class="hover:text-[var(--accent)] underline">首页</a>
          <span>/</span>
          <a href="/brands" class="hover:text-[var(--accent)] underline">42家品牌库</a>
          <span>/</span>
          <span class="text-[var(--fg-bright)] font-bold">{brand.name}</span>
        </nav>
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-[var(--fg-dim)]">品牌库天梯编号:</span>
          <span class="px-2 py-0.5 bg-[var(--border-color)] text-[var(--accent)] font-bold">
            RANK #{brand.rank}
          </span>
          {brand.isTop10 && (
            <span class="px-2 py-0.5 bg-amber-500/20 border border-amber-500 text-amber-300 font-bold text-[10px]">
              TOP 10 核心推荐
            </span>
          )}
        </div>
      </div>

      <!-- 品牌 Hero 核心概览卡片 -->
      <div class={`border-2 p-4 sm:p-6 space-y-4 ${brand.isFeatured ? 'border-amber-500 bg-gradient-to-r from-amber-950/20 to-[var(--bg-card)]' : 'border-[var(--border-active)] bg-[var(--bg-card)]'}`}>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="space-y-1 max-w-2xl">
            <div class="flex items-center gap-2.5">
              <h2 class="text-lg sm:text-2xl font-bold text-[var(--fg-bright)]">
                {brand.name}
              </h2>
              {brand.isFeatured && (
                <span class="px-2 py-0.5 bg-amber-500 text-black text-xs font-extrabold uppercase">
                  🏆 全网主推第一
                </span>
              )}
            </div>
            <p class="text-xs sm:text-sm text-[var(--accent)] font-semibold">
              {brand.tagline}
            </p>
          </div>

          <!-- 价格与购买 CTA -->
          <div class="flex flex-col items-start sm:items-end gap-1.5">
            <span class="text-[10px] text-[var(--fg-dim)]">入门起步门槛</span>
            <span class="text-xl sm:text-2xl font-bold text-emerald-400 font-mono">
              {brand.entryPrice}
            </span>
            <a
              href={brand.affLink}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="mt-1 px-5 py-2 bg-[var(--accent)] text-black font-extrabold text-xs sm:text-sm hover:opacity-90 transition-opacity flex items-center gap-1.5 shadow-lg"
            >
              <span>立即直达 {brand.name} 官网</span>
              <span>⚡</span>
            </a>
          </div>
        </div>

        <!-- 关键核心参数快速概览栏 -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-[var(--border-color)] text-xs">
          <div class="p-2.5 bg-[var(--bg-main)] border border-[var(--border-color)]">
            <span class="text-[10px] text-[var(--fg-dim)] block">线路架构</span>
            <span class="text-[var(--fg-bright)] font-bold">{brand.lineType}</span>
          </div>
          <div class="p-2.5 bg-[var(--bg-main)] border border-[var(--border-color)]">
            <span class="text-[10px] text-[var(--fg-dim)] block">独家优惠码</span>
            <div class="flex items-center gap-1 mt-0.5">
              <code class="text-amber-300 font-bold bg-black/50 px-1">{brand.coupon}</code>
              <button
                type="button"
                id="hero-copy-btn"
                data-coupon={brand.coupon}
                class="text-[10px] text-[var(--accent)] underline cursor-pointer"
              >
                复制
              </button>
            </div>
          </div>
          <div class="p-2.5 bg-[var(--bg-main)] border border-[var(--border-color)]">
            <span class="text-[10px] text-[var(--fg-dim)] block">支持协议</span>
            <span class="text-[var(--fg-bright)] font-bold">{brand.protocols.join(" / ")}</span>
          </div>
          <div class="p-2.5 bg-[var(--bg-main)] border border-[var(--border-color)]">
            <span class="text-[10px] text-[var(--fg-dim)] block">客户端支持</span>
            <span class="text-[var(--fg-bright)] font-bold truncate block">{brand.clientsSupported[0]} 等</span>
          </div>
        </div>
      </div>

      <!-- 实测测速大图与晚高峰下行表现 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3">
          <h3 class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span>
            <span>NODE SPEEDTEST // 晚高峰节点实测测速报告</span>
          </h3>
          <span class="text-[10px] text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2 py-0.5">
            PEAK_HOURS_VERIFIED
          </span>
        </div>

        {brand.speedtestImage ? (
          <div class="space-y-4">
            <p class="text-xs text-[var(--fg-main)] leading-relaxed">
              下图为实验室在晚高峰骨干网络高负载时段针对【{brand.name}】核心落地节点进行的单节点下行带宽与丢包率压力实测截图：
            </p>
            <div class="border border-[var(--border-color)] bg-black/60 p-2 sm:p-3 overflow-hidden">
              <img
                src={brand.speedtestImage}
                alt={`${brand.name} 节点测速实测报告截图`}
                loading="lazy"
                class="w-full max-h-[600px] object-contain rounded-none border border-[var(--border-color)] mx-auto hover:scale-[1.01] transition-transform duration-300"
              />
            </div>
          </div>
        ) : (
          <div class="p-4 border border-dashed border-[var(--border-color)] bg-[var(--bg-main)] text-xs text-[var(--fg-dim)] space-y-2">
            <div class="text-amber-400 font-bold">⚠️ 实测归档说明：</div>
            <p>该品牌历史测速数据正处于新一轮探针轮换测试周期中。当前节点连通率由自动化网络巡检系统保持全天候监控。</p>
          </div>
        )}

        <!-- TUI 复古字符测速指标看板 -->
        <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 sm:p-4 font-mono text-xs space-y-3">
          <div class="text-[var(--accent)] font-bold text-xs border-b border-[var(--border-color)] pb-1.5 flex justify-between">
            <span>📊 {brand.name} 核心节点性能基准 (TUI 矩阵监控)</span>
            <span class="text-[10px] text-[var(--fg-dim)]">10Gbps 对称探针</span>
          </div>
          <div class="space-y-2 text-xs">
            <div>
              <div class="flex justify-between text-[11px] mb-0.5">
                <span class="text-[var(--fg-bright)]">🟢 香港 IEPL / IPLC 专线</span>
                <span class="text-emerald-400 font-bold">延迟: 22ms~45ms | 下行: 450~529Mbps</span>
              </div>
              <div class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] h-3 relative">
                <div class="bg-emerald-500 h-full" style="width: 94%;"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[11px] mb-0.5">
                <span class="text-[var(--fg-bright)]">🟢 日本 东京 专线</span>
                <span class="text-emerald-400 font-bold">延迟: 57ms~68ms | 下行: 135~460Mbps</span>
              </div>
              <div class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] h-3 relative">
                <div class="bg-emerald-500 h-full" style="width: 86%;"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[11px] mb-0.5">
                <span class="text-[var(--fg-bright)]">🟢 新加坡 高速骨干</span>
                <span class="text-emerald-400 font-bold">延迟: 46ms~55ms | 下行: 387~420Mbps</span>
              </div>
              <div class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] h-3 relative">
                <div class="bg-emerald-500 h-full" style="width: 90%;"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[11px] mb-0.5">
                <span class="text-[var(--fg-bright)]">🟡 美国 洛杉矶 优化</span>
                <span class="text-yellow-400 font-bold">延迟: 140ms~170ms | 下行: 180~440Mbps</span>
              </div>
              <div class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] h-3 relative">
                <div class="bg-yellow-500 h-full" style="width: 72%;"></div>
              </div>
            </div>
          </div>
          <div class="text-[10px] text-[var(--fg-dim)] pt-1 flex justify-between border-t border-[var(--border-color)]">
            <span>汇总: 平均延迟 &lt;65ms | 丢包率: 0.0% | 抖动: &lt;2ms</span>
            <span class="text-[var(--accent)]">[jichangwang.cc]</span>
          </div>
        </div>
      </section>

      <!-- 流媒体与 AI 解锁矩阵实测 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3">
          <h3 class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span>
            <span>STREAMING & AI UNLOCK // 流媒体与人工智能原生解锁矩阵</span>
          </h3>
          <span class="text-[10px] text-[var(--accent)]">[REGION CHECK]</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5 text-xs font-mono">
          <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-color)] text-center space-y-1">
            <div class="text-base">🤖</div>
            <div class="font-bold text-[var(--fg-bright)]">ChatGPT</div>
            <div class="text-[10px] text-emerald-400 font-bold">{brand.streamingUnlock.chatgpt}</div>
          </div>
          <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-color)] text-center space-y-1">
            <div class="text-base">🧠</div>
            <div class="font-bold text-[var(--fg-bright)]">Claude 3.5</div>
            <div class="text-[10px] text-emerald-400 font-bold">{brand.streamingUnlock.claude}</div>
          </div>
          <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-color)] text-center space-y-1">
            <div class="text-base">✨</div>
            <div class="font-bold text-[var(--fg-bright)]">Gemini</div>
            <div class="text-[10px] text-emerald-400 font-bold">{brand.streamingUnlock.gemini}</div>
          </div>
          <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-color)] text-center space-y-1">
            <div class="text-base">🍿</div>
            <div class="font-bold text-[var(--fg-bright)]">Netflix 4K</div>
            <div class="text-[10px] text-emerald-400 font-bold">{brand.streamingUnlock.netflix}</div>
          </div>
          <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-color)] text-center space-y-1">
            <div class="text-base">🏰</div>
            <div class="font-bold text-[var(--fg-bright)]">Disney+</div>
            <div class="text-[10px] text-emerald-400 font-bold">{brand.streamingUnlock.disney}</div>
          </div>
          <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-color)] text-center space-y-1">
            <div class="text-base">▶️</div>
            <div class="font-bold text-[var(--fg-bright)]">YouTube 4K/8K</div>
            <div class="text-[10px] text-emerald-400 font-bold">{brand.streamingUnlock.youtube}</div>
          </div>
        </div>

        {brand.unlockImages && brand.unlockImages.length > 0 && (
          <div class="space-y-3 pt-2">
            <div class="text-xs font-bold text-[var(--fg-dim)] uppercase">
              📸 真实解锁与线路测试原图归档:
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {brand.unlockImages.slice(0, 3).map((img, idx) => (
                <div class="border border-[var(--border-color)] bg-black/40 p-1">
                  <img
                    src={img}
                    alt={`${brand.name} 线路解锁实测图 ${idx + 1}`}
                    loading="lazy"
                    class="w-full h-36 sm:h-44 object-cover hover:scale-105 transition-transform"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </section>

      <!-- 套餐价格明细表 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-3">
          <h3 class="text-xs sm:text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span>
            <span>PRICING & PACKAGES // 套餐规格与费率明细表</span>
          </h3>
          <span class="text-amber-400 text-xs font-bold">
            优惠码: <code class="bg-black/50 px-1 border border-amber-500/50">{brand.coupon}</code>
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono border-collapse">
            <thead>
              <tr class="border-b border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-dim)]">
                <th class="p-2.5">套餐名称</th>
                <th class="p-2.5">付费周期</th>
                <th class="p-2.5">价格</th>
                <th class="p-2.5">可用流量</th>
                <th class="p-2.5">定位特点</th>
                <th class="p-2.5 text-right">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-color)]">
              {brand.packages.map((pkg) => (
                <tr class="hover:bg-[var(--border-color)]/30 transition-colors">
                  <td class="p-2.5 font-bold text-[var(--fg-bright)]">{pkg.name}</td>
                  <td class="p-2.5 text-[var(--fg-dim)]">{pkg.period}</td>
                  <td class="p-2.5 font-bold text-emerald-400">{pkg.price}</td>
                  <td class="p-2.5 font-mono text-[var(--fg-main)]">{pkg.bandwidth}</td>
                  <td class="p-2.5 text-[var(--accent)]">{pkg.highlight || "-"}</td>
                  <td class="p-2.5 text-right">
                    <a
                      href={brand.affLink}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="px-2.5 py-1 border border-[var(--border-color)] hover:border-[var(--accent)] text-[var(--fg-bright)] hover:text-[var(--accent)] text-[11px] font-bold inline-block"
                    >
                      选购 ↗
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- 核心特色与优点/局限性客观分析 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 核心特点 -->
        <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-3">
          <h3 class="text-xs sm:text-sm font-bold text-[var(--fg-bright)] flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
            <span class="text-emerald-400">✓</span> 核心架构与技术亮点
          </h3>
          <ul class="space-y-2 text-xs text-[var(--fg-main)]">
            {brand.features.map((feat) => (
              <li class="flex items-start gap-2">
                <span class="text-[var(--accent)] font-bold">▪</span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- 优缺点实测点评 -->
        <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-3">
          <h3 class="text-xs sm:text-sm font-bold text-[var(--fg-bright)] flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
            <span class="text-yellow-400">⚖️</span> 优势与局限性客观总结
          </h3>
          <div class="space-y-2.5 text-xs">
            <div>
              <span class="text-emerald-400 font-bold block mb-1">【显著优点】</span>
              <ul class="space-y-1 text-[var(--fg-main)] pl-3">
                {brand.pros.map((p) => (
                  <li class="list-disc">{p}</li>
                ))}
              </ul>
            </div>
            <div>
              <span class="text-red-400 font-bold block mb-1">【注意事项与局限】</span>
              <ul class="space-y-1 text-[var(--fg-dim)] pl-3">
                {brand.cons.map((c) => (
                  <li class="list-disc">{c}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      </div>

      <!-- 测评实验室综合评价 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 sm:p-5 space-y-3">
        <h3 class="text-xs sm:text-sm font-bold text-[var(--fg-bright)] flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
          <span class="text-[var(--accent)]">></span> 实验室综合测评选购建议
        </h3>
        <p class="text-xs sm:text-sm text-[var(--fg-main)] leading-relaxed">
          {brand.summary}
        </p>
      </section>

      <!-- 底部吸底转化直达栏 -->
      <div class="p-4 border-2 border-[var(--border-active)] bg-[var(--bg-card)] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <div class="text-sm font-bold text-[var(--fg-bright)]">
            准备好开始畅享稳定跨境专线了吗？
          </div>
          <div class="text-xs text-[var(--fg-dim)]">
            使用专属优惠码 <code class="text-amber-300 font-bold font-mono">{brand.coupon}</code>，前往官网享折上折优惠。
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="bottom-copy-btn"
            data-coupon={brand.coupon}
            class="px-4 py-2 border border-[var(--border-color)] hover:border-[var(--accent)] text-[var(--fg-bright)] text-xs font-bold cursor-pointer transition-colors"
          >
            复制优惠码
          </button>
          <a
            href={brand.affLink}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-6 py-2 bg-[var(--accent)] text-black font-extrabold text-xs sm:text-sm hover:opacity-90 transition-opacity shadow"
          >
            直达 {brand.name} 官网 ⚡
          </a>
        </div>
      </div>
    </div>
  </TerminalWindow>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const handleCopy = (btnId: string) => {
      const btn = document.getElementById(btnId);
      btn?.addEventListener("click", () => {
        const coupon = btn.getAttribute("data-coupon");
        if (coupon) {
          navigator.clipboard.writeText(coupon);
          const orig = btn.textContent;
          btn.textContent = "已复制✓";
          setTimeout(() => {
            btn.textContent = orig;
          }, 2000);
        }
      });
    };

    handleCopy("hero-copy-btn");
    handleCopy("bottom-copy-btn");
  });
</script>
