---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import { PROXY_CLIENTS_DATA, PLATFORMS } from "../../data/clients";
import { TOOL_PLATFORMS, TOOL_ARTICLES } from "../../data/toolsData";
import { SITE_CONFIG } from "../../config/siteConfig";

const pageTitle = "全平台代理客户端选型横评与TUN模式深度调优指南 // 机场网 JichangWang.cc";
const pageDesc = "2026年 Windows/macOS/iOS/Android/Linux 全平台代理客户端合集与内核深度选型白皮书。全面涵盖 Clash Verge Rev、Sing-box、Shadowrocket 小火箭、v2rayN，提供 TUN 虚拟网卡全局接管、Fake-IP 原理、DNS 防泄漏与故障排查。";

const canonicalUrl = `${SITE_CONFIG.siteUrl}/clients`;

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "梯子工具与全平台代理客户端智库",
  "operatingSystem": "Windows, macOS, iOS, Android, Linux",
  "applicationCategory": "NetworkingApplication",
  "description": pageDesc,
  "url": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": "机场网技术测评实验室",
    "url": SITE_CONFIG.siteUrl
  }
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={[
    "机场客户端",
    "Clash Verge Rev下载",
    "Shadowrocket小火箭",
    "Sing-box配置教程",
    "TUN模式",
    "Fake-IP",
    "v2rayN教程",
    "代理客户端选型",
    "光速云订阅导入"
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <TerminalWindow currentPath="~/jichangwang/clients">
    <div class="space-y-8 font-mono text-xs md:text-sm select-text text-[var(--fg-main)]">
      
      <!-- 页面面包屑与状态 -->
      <nav class="flex items-center justify-between border-b border-[var(--border-color)] pb-2 text-xs text-[var(--fg-dim)]">
        <div class="flex items-center gap-1.5 overflow-x-auto whitespace-nowrap">
          <a href="/" class="hover:text-[var(--accent)]">首页</a>
          <span>&gt;</span>
          <span class="text-amber-300 font-bold">梯子工具与全平台客户端智库</span>
        </div>
        <span class="text-[10px] text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2 py-0.5">
          CLIENT_RADAR_2026
        </span>
      </nav>

      <!-- 核心速查提要：开头直接提供选型结论 -->
      <header class="border-2 border-amber-500/80 bg-[var(--bg-card)] p-5 md:p-7 rounded space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded text-xs font-bold mb-2">
              <span>🎯 机场网 2026 年度客户端选型直接结论 / DIRECT RECOMMENDATION</span>
            </div>
            <h1 class="text-xl md:text-3xl font-extrabold text-amber-400 leading-snug">
              全平台代理客户端技术选型与 TUN 模式深度调优全景白皮书
            </h1>
          </div>
        </div>

        <p class="text-xs md:text-sm text-[var(--fg-muted)] leading-relaxed font-sans">
          配置一个好的代理网络，后端专线是“发动机”，而客户端则是“方向盘与变速箱”。市面上的开源客户端繁多，技术路线已由早期的单一内核工具全面演进为支持多协议栈、虚拟网卡底层接管与复杂分流的现代化网络控制中心。
          <strong>对于 90% 的普通与进阶用户：</strong>
          Windows 与 macOS 平台首选 <strong>Clash Verge Rev</strong>（基于开源 Mihomo 内核，UI 现代、自带一键 TUN 模式且维护活跃）；
          iOS 平台首选 <strong>Shadowrocket（小火箭）</strong>（老牌稳定、协议兼容极广）；
          Android 平台首选 <strong>FlClash 或 Clash Meta for Android</strong>。
        </p>

        <!-- 关键决策指标卡片 -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-center font-mono">
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">PC端首选推荐</span>
            <span class="text-emerald-400 font-extrabold text-sm md:text-base">Clash Verge Rev</span>
          </div>
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">苹果手机首推</span>
            <span class="text-emerald-400 font-extrabold text-sm md:text-base">Shadowrocket</span>
          </div>
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">次世代极客内核</span>
            <span class="text-amber-300 font-extrabold text-sm md:text-base">Sing-box (通用)</span>
          </div>
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">推荐极速专线后端</span>
            <span class="text-amber-400 font-extrabold text-sm md:text-base">光速云 IEPL 专线</span>
          </div>
        </div>
      </header>

      <!-- 核心对比大表：全平台主流客户端深度参数矩阵 -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>[01]</span>
            <span>全平台主流代理客户端核心技术参数全景横评表</span>
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">2026 实机基准测试</span>
        </div>

        <div class="overflow-x-auto border border-[var(--border-color)] bg-[var(--bg-card)] rounded">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-[var(--bg-main)] text-amber-400 border-b border-[var(--border-color)]">
                <th class="p-3 font-bold whitespace-nowrap">客户端名称</th>
                <th class="p-3 font-bold whitespace-nowrap">支持系统</th>
                <th class="p-3 font-bold whitespace-nowrap">底层核心 (Kernel)</th>
                <th class="p-3 font-bold whitespace-nowrap">TUN 虚拟网卡</th>
                <th class="p-3 font-bold whitespace-nowrap">内存占用 (常驻)</th>
                <th class="p-3 font-bold whitespace-nowrap">分流与规则灵活性</th>
                <th class="p-3 font-bold whitespace-nowrap">上手门槛</th>
                <th class="p-3 font-bold whitespace-nowrap">综合推荐度</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-dim)] font-sans text-xs">
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-emerald-400 whitespace-nowrap">Clash Verge Rev</td>
                <td class="p-3 text-[var(--fg-dim)]">Win / Mac / Linux</td>
                <td class="p-3 font-mono text-white">Mihomo (Clash Meta)</td>
                <td class="p-3 text-emerald-400 font-bold">原生支持 (Wintun)</td>
                <td class="p-3 font-mono text-[var(--fg-dim)]">约 85MB ~ 140MB</td>
                <td class="p-3 text-emerald-400">极强 (支持 Script 与订阅扩展)</td>
                <td class="p-3 text-emerald-300">低 (UI 直观易用)</td>
                <td class="p-3 text-amber-400 font-bold">★★★★★ (桌面首推)</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">Shadowrocket (小火箭)</td>
                <td class="p-3 text-[var(--fg-dim)]">iOS / iPadOS / Apple M</td>
                <td class="p-3 font-mono text-white">自研高性能内核</td>
                <td class="p-3 text-emerald-400 font-bold">原生系统 VPN 接管</td>
                <td class="p-3 font-mono text-[var(--fg-dim)]">约 35MB ~ 60MB</td>
                <td class="p-3 text-emerald-400">极强 (支持模块、脚本与重写)</td>
                <td class="p-3 text-emerald-300">极低 (扫码即用)</td>
                <td class="p-3 text-amber-400 font-bold">★★★★★ (iOS 首推)</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">Sing-box (官方桌面版)</td>
                <td class="p-3 text-[var(--fg-dim)]">全平台覆盖</td>
                <td class="p-3 font-mono text-white">Sing-box 官方核心</td>
                <td class="p-3 text-emerald-400 font-bold">极速原生 TUN</td>
                <td class="p-3 font-mono text-emerald-400">&lt; 45MB (极度轻量)</td>
                <td class="p-3 text-yellow-300">专业级 JSON 规则链</td>
                <td class="p-3 text-red-400">极高 (需掌握配置语法)</td>
                <td class="p-3 text-amber-400 font-bold">★★★★☆ (极客首选)</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">v2rayN</td>
                <td class="p-3 text-[var(--fg-dim)]">Windows 独占</td>
                <td class="p-3 font-mono text-white">Xray / Sing-box 双核</td>
                <td class="p-3 text-yellow-300">支持 (需配置管理员服务)</td>
                <td class="p-3 font-mono text-[var(--fg-dim)]">约 70MB ~ 110MB</td>
                <td class="p-3 text-yellow-300">传统路由列表匹配</td>
                <td class="p-3 text-yellow-300">中等 (界面较繁杂)</td>
                <td class="p-3 text-white font-bold">★★★★☆ (传统经典)</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">FlClash</td>
                <td class="p-3 text-[var(--fg-dim)]">Android / Win / Mac</td>
                <td class="p-3 font-mono text-white">Mihomo 内核</td>
                <td class="p-3 text-emerald-400 font-bold">支持 VpnService / TUN</td>
                <td class="p-3 font-mono text-[var(--fg-dim)]">约 60MB ~ 90MB</td>
                <td class="p-3 text-emerald-400">多平台统一 UI 体验</td>
                <td class="p-3 text-emerald-300">低 (极简风格)</td>
                <td class="p-3 text-amber-400 font-bold">★★★★☆ (安卓推荐)</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">Surge Mac / iOS</td>
                <td class="p-3 text-[var(--fg-dim)]">Apple 生态独占</td>
                <td class="p-3 font-mono text-white">Surge 专属商业内核</td>
                <td class="p-3 text-emerald-400 font-bold">顶级系统级接管 (Enhanced)</td>
                <td class="p-3 font-mono text-[var(--fg-dim)]">约 40MB ~ 70MB</td>
                <td class="p-3 text-emerald-400 font-bold">工业级抓包与精细分流</td>
                <td class="p-3 text-yellow-300">中高 (商业付费门槛)</td>
                <td class="p-3 text-purple-400 font-bold">★★★★★ (果粉神机)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 四大平台分类知识 Hub 与长尾文献矩阵 -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>[02]</span>
            <span>四大操作系统平台专属分类专区与实战配置指南</span>
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">点击进入操作系统专区</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {TOOL_PLATFORMS.map((plat) => {
            const count = TOOL_ARTICLES.filter((a) => a.platform === plat.slug).length;
            return (
              <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 rounded space-y-3 hover:border-amber-400/60 transition-colors">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-2xl">{plat.icon}</span>
                    <h3 class="text-base font-bold text-white">
                      <a href={`/clients/${plat.slug}`} class="hover:underline">{plat.name}</a>
                    </h3>
                  </div>
                  <span class="text-xs text-amber-400 bg-amber-950/40 border border-amber-800/40 px-2 py-0.5 rounded font-mono">
                    {count} 篇深度指南
                  </span>
                </div>
                <p class="text-xs text-[var(--fg-muted)] leading-relaxed font-sans">
                  {plat.description}
                </p>
                <div class="pt-2 border-t border-[var(--border-dim)] flex items-center justify-between">
                  <span class="text-[11px] text-emerald-400 font-mono">首推应用：{plat.recommendedApp}</span>
                  <a href={`/clients/${plat.slug}`} class="text-xs text-amber-400 hover:underline font-bold">
                    进入平台专区 &gt;&gt;
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <!-- 长尾精选配置实战文献 -->
        <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 rounded space-y-3">
          <span class="text-xs font-bold text-amber-300 block">📚 重点实战配置与长尾文献索引：</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            {TOOL_ARTICLES.map((art) => (
              <a href={`/clients/${art.platform}/${art.slug}`} class="p-2.5 bg-[var(--bg-main)] hover:bg-white/5 border border-[var(--border-dim)] hover:border-amber-400/40 rounded flex items-center justify-between gap-2 group">
                <span class="text-[var(--fg-main)] group-hover:text-amber-300 truncate">{art.title}</span>
                <span class="text-[10px] text-amber-400 border border-amber-900/60 px-1.5 py-0.2 shrink-0">{art.difficulty}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 客户端软件官方直连下载卡片库 -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>[03]</span>
            <span>常用开源客户端官方渠道与 GitHub 发布仓库直达</span>
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">杜绝第三方二次打包后门</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {PROXY_CLIENTS_DATA.map((client) => (
            <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 rounded space-y-2.5 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between border-b border-[var(--border-dim)] pb-2">
                  <div class="flex items-center gap-2">
                    <h3 class="text-sm font-bold text-white">{client.name}</h3>
                    {client.isRecommended && (
                      <span class="text-[9px] px-1.5 py-0.2 bg-emerald-500 text-black font-extrabold uppercase">
                        首推
                      </span>
                    )}
                  </div>
                  <span class="text-[10px] px-2 py-0.5 bg-black/40 text-[var(--fg-dim)] font-mono border border-[var(--border-dim)]">
                    {client.platform}
                  </span>
                </div>
                <p class="text-xs text-[var(--fg-muted)] pt-2 font-sans leading-relaxed">
                  {client.description}
                </p>
              </div>

              <div class="pt-2 border-t border-[var(--border-dim)] flex items-center justify-between">
                <span class="text-[11px] text-amber-400/80 font-mono">内核：{client.kernel}</span>
                <a
                  href={client.downloadUrl}
                  target="_blank"
                  rel="nofollow noopener"
                  class="px-3 py-1 bg-[var(--bg-main)] hover:bg-amber-500 hover:text-black border border-[var(--border-color)] text-xs font-mono transition-colors rounded"
                >
                  官方仓库下载 &gt;&gt;
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 专著级深度解析正文长文：章节 04 到 12 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-8 rounded space-y-10 font-sans leading-relaxed text-sm">
        
        <!-- 章节 04: 系统代理 vs TUN 虚拟网卡底层原理 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[04]</span>
            <span>系统代理（System Proxy）vs TUN 模式底层工作原理全景剖析</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            在代理客户端的日常使用中，最常困扰技术人员的问题就是：“为什么我明明在客户端里打开了代理开关，浏览器看 YouTube 很流畅，但是打开系统命令行（PowerShell / Terminal）输入 git clone 却报错超时？为什么运行 Steam 联机游戏依然显示红字高延迟？”要回答这个问题，必须彻底理清<strong>系统代理（System Proxy）</strong>与<strong>TUN 虚拟网卡模式</strong>在操作系统网络协议栈中的工作层级。
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
            <div class="p-4 bg-[var(--bg-main)] border border-yellow-500/40 rounded space-y-2">
              <span class="font-bold text-yellow-300 block text-sm">【传统系统代理 (System Proxy) - 应用层协作机制】</span>
              <p class="text-[var(--fg-muted)] font-sans leading-relaxed">
                系统代理的实质是操作系统提供的一种“建议性环境变量”。当你在 Clash 或 v2rayN 中开启系统代理时，软件只是在 Windows 注册表（Internet Settings）或 macOS 系统网络偏好中，将 HTTP/SOCKS 代理地址修改为 127.0.0.1:7890。
                这种模式高度依赖具体的应用程序是否主动去读取系统的代理设置。现代 Web 浏览器（Chrome、Edge、Safari）会主动遵从这个注册表值，因此网页浏览可以顺利走代理。但绝大多数开发者工具（如 Git、Docker、Node.js、Python requests）、即时通讯工具以及 99% 的 3D 网络游戏，根本不会去读取系统代理环境变量，它们直接通过系统底层 Socket 发送原始 TCP/UDP 数据包，从而彻底绕过了代理客户端，导致依然直连并发生超时。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-emerald-500/40 rounded space-y-2">
              <span class="font-bold text-emerald-300 block text-sm">【现代 TUN 虚拟网卡模式 - 网络层内核强制接管】</span>
              <p class="text-[var(--fg-muted)] font-sans leading-relaxed">
                TUN 模式则是完全不同的降维打击。当在 Clash Verge Rev 或 Sing-box 中开启 TUN 模式时，软件会利用 Wintun（Windows）或 utun（macOS/Linux）在操作系统网络驱动层虚拟出一张专属网卡，并将操作系统的默认网关路由表（Default Gateway 0.0.0.0/0）的跃点数（Metric）强行设置为最高优先级。
                此时，操作系统上所有进程发出的所有网络数据帧（无论是浏览器、终端命令行、后台服务还是 3D 大型联机游戏），在刚刚离开应用程序准备进入物理网卡前，全部被强行截获并重定向写入到 TUN 虚拟网卡管道中。在 TUN 模式下，用户再也无需为 Git、命令行或各种特定软件单独配置端口代理，实现真正的<strong>100% 全局无死角网络接管</strong>。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 05: Fake-IP 与 Redir-Host 机制深度释疑 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[05]</span>
            <span>DNS 核心解析机制解密：Fake-IP vs Redir-Host 优缺点与最佳配置</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            在现代代理软件（尤其是基于 Clash Meta/Mihomo 和 Sing-box）的 DNS 设置中，经常看到 Fake-IP 与 Redir-Host 两个选项。这是代理软件处理域名解析的核心分水岭技术：
          </p>

          <div class="space-y-3 font-mono text-xs">
            <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-1.5">
              <div class="flex justify-between items-center text-amber-300 font-bold">
                <span class="text-sm">Fake-IP 模式（极速预分配机制，推荐默认使用）</span>
                <span class="text-[10px] px-2 py-0.5 bg-emerald-950/40 text-emerald-300 border border-emerald-800/40 rounded">现代标准</span>
              </div>
              <p class="text-[var(--fg-muted)] font-sans">
                【工作原理】：当应用程序发起一个域名查询请求（例如 google.com）时，代理软件的内置 DNS 服务器根本不会向远端发起真实的 DNS 解析，而是瞬间从本地保留的保留网段（如 198.18.0.1/16）中，直接抓取一个虚假的 IP 地址并立即返回给应用程序（耗时小于 1ms）。应用程序拿到这个 Fake-IP 后，立即向该 IP 发起 TCP SYN 连接。代理内核截获这个 SYN 包后，从本地字典中查出该 Fake-IP 对应的真实域名是 google.com，随后将完整的域名直接塞入代理协议的目标请求头部发往远端境外服务器，由境外服务器代为解析最终真实 IP。
                【核心优势】：彻底终结本地 DNS 污染、完全避免本地 DNS 查询泄露个人隐私、网页建立 TCP 握手耗时从上百毫秒压缩到极限。
              </p>
            </div>

            <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-1.5">
              <div class="flex justify-between items-center text-amber-300 font-bold">
                <span class="text-sm">Redir-Host 模式（传统逐域解析机制，兼容特定局域网）</span>
                <span class="text-[10px] px-2 py-0.5 bg-yellow-950/40 text-yellow-300 border border-yellow-800/40 rounded">兼容模式</span>
              </div>
              <p class="text-[var(--fg-muted)] font-sans">
                【工作原理】：应用程序请求 google.com 时，客户端必须老老实实通过配置的境外远程 DNS 服务器进行解析，等远端返回了真实的公网 IP 后，再根据 IP 规则表判断是否需要代理。
                【主要缺陷】：在弱网或网络存在高抖动时，每个域名的首次访问都会面临漫长的 DNS 查询往返延迟；同时国内运营商对未加密的 53 端口 DNS 查询实施了全量污染，极易导致解析返回错误的毒化 IP。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 06: 规则分流体系与策略组设计艺术 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[06]</span>
            <span>规则分流体系与策略组构建：实现国内直连、海外加速的终极配置</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            一套成熟的代理规则，核心目标是做到<strong>“该走国内直连的毫秒必争，该走海外专线的丝滑稳定”</strong>。在现代规则集（Rule-Set）中，主要依托以下分层判定流水线：
          </p>

          <div class="space-y-3 text-xs font-mono">
            <div class="p-3 bg-black/50 border border-[var(--border-dim)] rounded space-y-1">
              <span class="text-amber-400 font-bold block">1. 局域网与私有地址放行层（LAN Bypass）</span>
              <p class="text-[var(--fg-muted)] font-sans">
                规则第一优先级：必须拦截并放行 127.0.0.1、192.168.0.0/16、10.0.0.0/8 以及 *.local 局域网广播域名，强制其走 DIRECT 直连，避免打印机、NAS 私有云以及路由器后台管理页面被误转至海外代理。
              </p>
            </div>

            <div class="p-3 bg-black/50 border border-[var(--border-dim)] rounded space-y-1">
              <span class="text-amber-400 font-bold block">2. 核心大厂与金融合规直连层（Direct List）</span>
              <p class="text-[var(--fg-muted)] font-sans">
                匹配 GEOSITE:CN 与 GEOIP:CN 规则库。涵盖所有国内头部应用（如微信、钉钉、淘宝、京东、Bilibili、网易云音乐）。通过高频更新的开源数据库，确保国内应用不经过任何境外专线，享有国内运营商全速带宽。
              </p>
            </div>

            <div class="p-3 bg-black/50 border border-[var(--border-dim)] rounded space-y-1">
              <span class="text-amber-400 font-bold block">3. 精细化海外业务分流策略组（Target Routing Groups）</span>
              <p class="text-[var(--fg-muted)] font-sans">
                为特定海外场景构建独立的策略组：
                • <strong>AI 大模型专线组：</strong> 绑定具备原生住宅 IP 的节点（如光速云定制版），专门承接 openai.com、anthropic.com、claude.ai，杜绝 IP 漂移导致封号；
                • <strong>流媒体解锁组：</strong> 绑定亚太原生落地节点（香港、日本、新加坡），定向承接 Netflix、Disney+、Spotify；
                • <strong>海外技术开发组：</strong> 定向承接 github.com、docker.com、stackoverflow.com。
              </p>
            </div>

            <div class="p-3 bg-black/50 border border-[var(--border-dim)] rounded space-y-1">
              <span class="text-amber-400 font-bold block">4. 漏网之鱼与默认兜底层（FINAL / MATCH）</span>
              <p class="text-[var(--fg-muted)] font-sans">
                所有未命中前置明确规则的未知长尾流量，统一流入兜底策略组（PROXY），并根据健康检查优选延迟最低的节点传输，确保任何新海外网站均能正常访问。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 07: 客户端四大常见疑难杂症排查与故障树 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[07]</span>
            <span>客户端高频疑难杂症与深度故障树排查手册（Troubleshooting Tree）</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            使用代理软件时难免遇到各种环境冲突，以下是基于数千名技术用户反馈总结的最权威故障解决方案：
          </p>

          <div class="space-y-3 font-mono text-xs">
            <div class="p-4 bg-[var(--bg-main)] border border-red-500/40 rounded space-y-2">
              <span class="text-red-400 font-bold block text-sm">【故障一：代理关闭后，电脑彻底断网，无法打开任何网页】</span>
              <p class="text-[var(--fg-muted)] font-sans leading-relaxed">
                <strong>症状：</strong> 在托盘退出客户端或电脑异常关机后，浏览器打开任何国内网页均提示“无法连接到代理服务器 / ERR_PROXY_CONNECTION_FAILED”。
                <strong>根因：</strong> 客户端在意外退出前，没来得及将系统注册表中的系统代理开关复位，导致操作系统依然执着地把网络流量发送到已经关闭的 127.0.0.1:7890 端口。
                <strong>一键解决方案：</strong>
                按下 Win + R 打开运行窗口，输入 <code>inetcpl.cpl</code> 打开“Internet 属性” -> 点击“连接”标签页 -> 点击底部“局域网设置” -> <strong>取消勾选“为 LAN 使用代理服务器”</strong> -> 点击确定保存，网络瞬间恢复如初。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-yellow-500/40 rounded space-y-2">
              <span class="text-yellow-300 font-bold block text-sm">【故障二：Windows 应用商店、邮件及 UWP 应用无法联网】</span>
              <p class="text-[var(--fg-muted)] font-sans leading-relaxed">
                <strong>症状：</strong> Chrome 浏览器翻墙顺畅，但 Windows Store 提示错误代码 0x80072EFD，Xbox 登录提示无网络连接。
                <strong>根因：</strong> 微软在 Windows 10/11 中引入了 UWP 容器沙箱隔离安全策略，默认强制禁止所有 UWP 应用访问本机回环地址（127.0.0.1 Loopback），导致其无法连接本地运行的代理客户端。
                <strong>解决方案：</strong>
                在 Clash Verge Rev 中点击“设置” -> 找到“系统回环代理豁免工具（UWP Loopback Tool）” -> 点击打开并点击“Exempt All（全选豁免）”保存即可完美解决。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-yellow-500/40 rounded space-y-2">
              <span class="text-yellow-300 font-bold block text-sm">【故障三：启动客户端提示端口冲突 7890 已经被占用】</span>
              <p class="text-[var(--fg-muted)] font-sans leading-relaxed">
                <strong>症状：</strong> 客户端内核启动失败，弹窗提示 <code>listen tcp 127.0.0.1:7890: bind: address already in use</code>。
                <strong>根因：</strong> 之前未完全退出的旧代理进程在后台残留，或者迅雷、百度网盘、各类流媒体加速器抢占了 7890 默认端口。
                <strong>解决方案：</strong>
                在客户端设置中，将 Mixed Port（混合端口）从默认的 7890 修改为非冲突端口（如 17890 或 27890）即可重新启动。或者打开任务管理器强制结束带有 clash-meta 或 mihomo 名字的后台僵尸进程。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 08: 订阅安全警示：严禁使用公开在线订阅转换 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[08]</span>
            <span>重大安全防线：为什么严禁使用公开第三方在线订阅转换工具？</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            很多用户为了将机场提供的原始订阅链接转换成特定客户端的格式，习惯在搜索工具中随手搜索“在线订阅转换”并将自己的订阅链接粘贴进去。这是极度危险的资产泄露行为！
          </p>

          <div class="p-4 bg-red-950/20 border-l-4 border-red-500 text-xs md:text-sm text-red-200 rounded-r space-y-2 font-sans">
            <span class="font-bold text-red-300 block">⚠️ 公开在线订阅转换的致命安全陷阱：</span>
            <p class="leading-relaxed">
              1. <strong>全量订阅泄露与流量被盗：</strong> 你的订阅链接中包含了你账户完整的鉴权 Token 和所有节点的服务器 IP、端口、密码。不可信的订阅转换后端会将这些信息全部静默记录在数据库中，并在后台盗用你的专线流量作为爬虫代理；
              <br />
              2. <strong>中间人注入恶意节点与广告：</strong> 转换服务器可以在生成的配置文件中恶意插入它自己的广告节点、或者替换特定的分流规则，将你的金融访问引导至钓鱼服务器；
              <br />
              3. <strong>正确做法：</strong> 优先使用优质机场（如光速云）官方后台提供的一键直连导入按钮；如果确实需要高级转换，应在本地通过 Docker 部署开源安全的 Subconverter 服务，数据绝对不经过任何第三方公网服务器。
            </p>
          </div>
        </div>

        <!-- 章节 09: 内核生态演进史：从原版 Clash 到 Mihomo 与 Sing-box 的争鸣 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[09]</span>
            <span>内核演进全景：从原版 Clash 停更到 Mihomo 与 Sing-box 双雄并立</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            要深刻理解梯子客户端的技术演进，必须回顾 2023 年底代理生态发生的标志性历史事件。原版 Clash 核心作者与 Clash for Windows 作者相继宣布删库停止维护，曾经一统江湖的传统生态瞬间进入剧烈的重构洗牌期。
          </p>
          <p class="text-[var(--fg-main)]">
            在这场大变革中，两大开源分支脱颖而出，成为了当前整个行业的中流砥柱：
          </p>
          <div class="space-y-4 text-xs font-sans">
            <div class="p-4 bg-[var(--bg-main)] border border-emerald-500/30 rounded space-y-2">
              <span class="font-bold text-emerald-300 block text-sm">1. Mihomo（原 Clash.Meta）内核生态</span>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                Mihomo 是在原版 Clash 基础上经过全球开源社区持续重构而成的现代超集。它不仅完全向下兼容所有既有的 Clash YAML 配置文件，更原生支持了 VLESS、Reality、Hysteria 2、TUIC、WireGuard 等全新协议，内置了高性能 Wintun 驱动与智能 Fake-IP DNS 缓存。搭配现代化 UI 外壳 Clash Verge Rev，成为了绝大多数桌面端用户的平滑升级首选。
              </p>
            </div>
            <div class="p-4 bg-[var(--bg-main)] border border-amber-500/30 rounded space-y-2">
              <span class="font-bold text-amber-300 block text-sm">2. Sing-box（次世代通用通用网络代理平台）</span>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                Sing-box 由 Nekoray 等开源核心开发者从零用 Go 语言编写，彻底摆脱了 Clash 历史架构的包袱。它采用了统一且现代化的 JSON 规则链配置语法，内存占用仅为传统客户端的 1/3，网络吞吐量和并发处理能力达到了前所未有的工业级高度。Sing-box 在移动端（iOS / Android）和 Linux 软路由系统上展现出了极强的统治力，已成为高阶极客与网络工程师的最爱。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 10: 跨平台移动端专项优化技巧 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[10]</span>
            <span>移动端专项调优：iOS 与 Android 代理客户端低耗电与长效保活秘笈</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            智能手机与桌面电脑最大的不同在于其受限的电池容量与严苛的操作系统后台杀死机制。如果不进行精细化设置，开启代理客户端可能会导致手机异常发热、耗电飞快或后台被频繁杀掉。
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-sans">
            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <span class="font-bold text-amber-300 block text-sm">🍎 iOS 平台（小火箭 / Loon / Surge）省电调优指南</span>
              <ul class="list-disc pl-4 space-y-1.5 text-[var(--fg-muted)] leading-relaxed">
                <li>关闭不必要的日志记录（Log Level 设置为 Warning 或 Error），避免频繁写入本地闪存引起发热；</li>
                <li>启用“按需连接（On-Demand）”，当连接特定受信任家庭 Wi-Fi 时可配置自动休眠；</li>
                <li>避免订阅过多庞大的臃肿规则集，将规则总行数控制在 5000 行以内，显著降低系统内存常驻占用。</li>
              </ul>
            </div>
            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <span class="font-bold text-amber-300 block text-sm">🤖 Android 平台（FlClash / CMFA / v2rayNG）长效保活指南</span>
              <ul class="list-disc pl-4 space-y-1.5 text-[var(--fg-muted)] leading-relaxed">
                <li>进入系统“电池优化”设置，将代理客户端设置为“无限制 / 不优化”，防止锁屏后被系统后台省电策略强杀；</li>
                <li>在多任务后台卡片界面中，将代理客户端下拉加锁（Lock App）；</li>
                <li>开启系统的“常驻通知栏小图标”，利用 Android 原生前台服务机制提升进程优先级（OOM Adj 值降为 0）。</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 章节 11: 软路由与网关透明代理进阶架构设计 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[11]</span>
            <span>极客家庭网络演进：OpenWrt / 旁路由透明代理架构规划</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            当家中有 Apple TV、PlayStation 5、Nintendo Switch、智能音箱等无法直接安装客户端的非标准设备时，在主路由器或独立迷你主机（如 N100、R4S）上部署旁路由网关透明代理是终极解决方案：
          </p>
          <div class="space-y-3 font-mono text-xs">
            <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-1.5">
              <span class="text-amber-400 font-bold block">1. 主旁路由拓扑与 DHCP 网关指定机制</span>
              <p class="text-[var(--fg-muted)] font-sans">
                保持光猫或硬路由作为主路由负责拨号和 Wi-Fi 信号覆盖（IP: 192.168.1.1）；将刷入了 OpenWrt 的小主机接入局域网并分配静态 IP（192.168.1.2）。对于需要翻墙的电脑、电视或主机设备，仅需在设备的手动网络设置中，将网关和 DNS 填入旁路由 IP（192.168.1.2）；而父母的长辈手机保持默认 DHCP 自动分配，依然走主路由直连，做到“一人折腾，全家无感，互不影响”。
              </p>
            </div>
            <div class="p-3 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-1.5">
              <span class="text-amber-400 font-bold block">2. OpenClash 与 ShellCrash 核心选型</span>
              <p class="text-[var(--fg-muted)] font-sans">
                OpenClash 拥有极其华丽的 WebUI 面板和可视化规则调整能力，适合配置较高的 x86 软路由；而 ShellCrash 则是一款纯命令行小脚本，几乎不占用任何 CPU 与闪存空间，适合刷了第三方固件的硬路由（如小米、华硕路由器）。无论选择哪款，均推荐配置 TUN 模式加 Fake-IP，实现全屋智能家电的零感知科学出海。
              </p>
            </div>
          </div>
        </div>

        
        <!-- 章节 13: 现代代理内核基准测试：Mihomo vs Sing-box 压测实录 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[13]</span>
            <span>现代代理内核基准压力测试：Mihomo vs Sing-box 工业级性能对比</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            为了给高吞吐量需求（如 4K/8K 视频制作、海量海外数据集下载、高频量化交易）的用户提供可量化的参考依据，机场网技术测评实验室在配备 Intel i9-14900K、64GB DDR5 内存的物理测试机上，通过万兆本地虚拟回环环境，对两大主流内核进行了严苛的基准压测：
          </p>

          <div class="space-y-4 text-xs font-sans">
