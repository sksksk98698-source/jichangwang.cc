              <p class="text-[var(--fg-muted)] font-sans">
                将以下函数添加到你的 <code>~/.zshrc</code> 或 <code>~/.bashrc</code> 文件末尾，随时在终端中输入 <code>proxy_on</code> 开启、<code>proxy_off</code> 关闭：
              </p>
              <pre class="p-2.5 bg-black/80 text-amber-300 rounded overflow-x-auto">
# 终端快捷代理函数
function proxy_on() &#123;
    export http_proxy="http://127.0.0.1:7890"
    export https_proxy="http://127.0.0.1:7890"
    export all_proxy="socks5://127.0.0.1:7890"
    echo "⚡ 终端代理已开启 [127.0.0.1:7890]"
    curl -m 3 https://api.ipify.org
&#125;

function proxy_off() &#123;
    unset http_proxy https_proxy all_proxy
    echo "❌ 终端代理已完全关闭"
&#125;
              </pre>
