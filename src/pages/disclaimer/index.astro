---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import { SITE_CONFIG } from "../../config/siteConfig";

const pageTitle = "免责声明与服务条款 // 机场网 JichangWang.cc";
const pageDesc = "机场网技术测评实验室 (JichangWang.cc) 法律免责声明、版权保护政策与合理使用协议。";

const canonicalUrl = `${SITE_CONFIG.siteUrl}/disclaimer`;

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDesc,
  "url": canonicalUrl
};
---

<Layout title={pageTitle} description={pageDesc} keywords={["免责声明", "服务条款", "版权声明", "用户协议", "合规提示"]}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} slot="head" />

  <TerminalWindow currentPath="~/jichangwang/disclaimer">
    <div class="space-y-8 font-mono text-xs md:text-sm select-text text-[var(--fg-main)]">
      
      <!-- 页面面包屑与状态 -->
      <nav class="flex items-center justify-between border-b border-[var(--border-color)] pb-2 text-xs text-[var(--fg-dim)]">
        <div class="flex items-center gap-1.5 overflow-x-auto whitespace-nowrap">
          <a href="/" class="hover:text-[var(--accent)]">首页</a>
          <span>&gt;</span>
          <span class="text-amber-300 font-bold">法律声明与免责协议</span>
        </div>
        <span class="text-[10px] text-amber-400 bg-amber-950/40 border border-amber-800/50 px-2 py-0.5">
          LEGAL_POLICY
        </span>
      </nav>

      <!-- 主标题区 -->
      <header class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-6 rounded space-y-3">
        <h1 class="text-lg md:text-2xl font-bold text-amber-400">
          机场网 (JichangWang.cc) 法律声明与合理使用准则
        </h1>
        <p class="text-xs text-[var(--fg-muted)] leading-relaxed font-sans">
          最后更新时间：2026 年 11 月。在访问或使用本站提供的信息前，请务必审慎阅读本声明的全部条款。
        </p>
      </header>

      <!-- 条款正文 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-8 rounded space-y-6 font-sans leading-relaxed text-xs md:text-sm text-[var(--fg-main)]">
        
        <div class="space-y-2">
          <h2 class="font-bold text-amber-300 font-mono text-sm">一、 技术研究与信息服务性质</h2>
          <p class="text-[var(--fg-muted)]">
            本站仅为计算机网络工程、分布式协议、开源代理客户端软件配置以及跨国网络质量监测的技术研究智库。本站自身不销售、不运营、不搭建任何违规境外网络连接通道，亦不向用户提供任何违法翻墙服务。
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="font-bold text-amber-300 font-mono text-sm">二、 用户合规用网与守法义务</h2>
          <p class="text-[var(--fg-muted)]">
            所有访问本站的用户应严格遵守《中华人民共和国网络安全法》、《计算机信息网络国际联网管理暂行规定》以及当地适用的法律法规。本站介绍的技术工具仅限用于跨境学术科研、合法合规跨境电商企业运营及海外开源技术协同。严禁任何个人或组织将本站的技术内容用于从事危害国家安全、传播有害信息或侵犯他人合法权益的非法活动。
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="font-bold text-amber-300 font-mono text-sm">三、 第三方服务商免责条款</h2>
          <p class="text-[var(--fg-muted)]">
            本站收录的第三方品牌服务商（包括 42 家机场品牌及客户端作者）均为完全独立的第三方主体。本站对其提供的网络服务质量、财务稳健度以及运营持续性不提供任何形式的明示或暗示担保。用户在选择任何第三方服务前，应理性评估风险。若因第三方服务商自身发生服务器故障、割接停机或商业倒闭跑路而造成的数据损失或财务损失，本站概不承担连带法律责任。
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="font-bold text-amber-300 font-mono text-sm">四、 知识产权与原创内容保护</h2>
          <p class="text-[var(--fg-muted)]">
            本站原创编写的万字专著级技术白皮书、实测图表数据、TUI 字符图谱及架构代码均受著作权法保护。未经本站明确书面许可，严禁任何媒体、爬虫程序或内容农场进行全量抓取、洗稿或恶意抄袭。
          </p>
        </div>

      </section>

      <!-- 底部全局导航 -->
      <footer class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 flex flex-wrap justify-between items-center gap-4 text-xs">
        <a href="/" class="text-amber-400 hover:underline">&larr; 返回智库首页</a>
        <div class="flex gap-4 text-[var(--fg-dim)]">
          <a href="/about" class="hover:text-white">关于实验室</a>
          <a href="/brands" class="hover:text-white">42家品牌库</a>
          <a href="/free" class="hover:text-white">免费资源</a>
          <a href="/clients" class="hover:text-white">梯子工具</a>
          <a href="/faq" class="hover:text-white">机场FAQ</a>
          <a href="/alerts" class="hover:text-white">跑路预警</a>
        </div>
      </footer>

    </div>
  </TerminalWindow>
</Layout>
