---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import { FAQ_CATEGORIES, FAQ_ARTICLES } from "../../data/faqData";
import { SITE_CONFIG } from "../../config/siteConfig";

const pageTitle = "机场常见问题技术答疑与全景排障百科 // 机场网 JichangWang.cc";
const pageDesc = "2026年机场选购、网络协议、客户端排障与海外AI解锁全景问答智库。深入解答 IEPL 专线原理、VLESS Reality 协议、ChatGPT 1020 报错、Netflix 伪解锁以及关闭代理无法上网等高频疑难杂症。";

const canonicalUrl = `${SITE_CONFIG.siteUrl}/faq`;

// 提取核心高频问题生成 Schema.org FAQPage 富媒体结构化数据
const schemaJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "IEPL 内网专线和普通公网中继机场有什么本质区别？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "IEPL 是两端机房之间通过物理光纤直接打通的内网专线，数据完全不过公网国际出口防火墙，晚高峰丢包率为 0%，且物理延迟恒定。而公网中继依然走公网民用骨干网，晚高峰拥塞严重且存在被阻断断连的风险。"
      }
    },
    {
      "@type": "Question",
      "name": "关掉代理客户端后电脑彻底断网，打不开任何国内网页怎么办？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "按 Win + R 打开运行输入 inetcpl.cpl，在连接-局域网设置中取消勾选“为 LAN 使用代理服务器”，即可一秒恢复网络。"
      }
    },
    {
      "@type": "Question",
      "name": "访问 ChatGPT 提示 Access Denied 1020 是什么原因？如何解决？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "这是由于当前节点 IP 被 Cloudflare 与 OpenAI 标记为机房高危垃圾广播 IP。解决办法是选用具备海外纯净原生 IP 或住宅 IP 的专线机场（如光速云），并保持浏览器无痕模式登录。"
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={[
    "机场FAQ",
    "IEPL专线是什么",
    "ChatGPT 1020报错",
    "代理关闭打不开网页",
    "Fake-IP原理",
    "Netflix解锁检测",
    "机场倍率是什么意思",
    "光速云优惠码"
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <TerminalWindow currentPath="~/jichangwang/faq">
    <div class="space-y-8 font-mono text-xs md:text-sm select-text text-[var(--fg-main)]">
      
      <!-- 页面面包屑与状态 -->
      <nav class="flex items-center justify-between border-b border-[var(--border-color)] pb-2 text-xs text-[var(--fg-dim)]">
        <div class="flex items-center gap-1.5 overflow-x-auto whitespace-nowrap">
          <a href="/" class="hover:text-[var(--accent)]">首页</a>
          <span>&gt;</span>
          <span class="text-amber-300 font-bold">机场 FAQ 常见问题智库</span>
        </div>
        <span class="text-[10px] text-amber-400 bg-amber-950/40 border border-amber-800/50 px-2 py-0.5">
          KNOWLEDGE_BASE_2026
        </span>
      </nav>

      <!-- 核心速查提要：开头直接提供答案 -->
      <header class="border-2 border-amber-500/80 bg-[var(--bg-card)] p-5 md:p-7 rounded space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded text-xs font-bold mb-2">
              <span>💡 机场网问答智库核心答疑索引 / DIRECT ANSWER CENTER</span>
            </div>
            <h1 class="text-xl md:text-3xl font-extrabold text-amber-400 leading-snug">
              机场常见技术疑问、网络协议与故障排查权威百科全书
            </h1>
          </div>
        </div>

        <p class="text-xs md:text-sm text-[var(--fg-muted)] leading-relaxed font-sans">
          跨境网络涉及传输层加密、物理专线承载、跨国 BGP 路由、DNS 解析与海外风控识别等多维复杂工程体系。面对琳琅满目的技术术语与偶发网络故障，绝大多数用户往往无从下手。
          本专题汇聚了机场网技术实验室历经 4 年、测试 42 家主流品牌沉淀下来的核心技术问答库，涵盖从<strong>底层线路原理、客户端疑难报错、流媒体与大模型防封到商业模式避坑</strong>的全部细节，一站式解决所有用网疑难。
        </p>

        <!-- 关键高频问题极速直达卡片 -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-center font-mono">
          <a href="#section-protocols" class="p-3 bg-black/40 border border-[var(--border-dim)] hover:border-amber-400/60 rounded block">
            <span class="text-[10px] text-[var(--fg-dim)] block">线路原理篇</span>
            <span class="text-amber-300 font-bold text-xs md:text-sm">IEPL vs IPLC 区别</span>
          </a>
          <a href="#section-troubleshooting" class="p-3 bg-black/40 border border-[var(--border-dim)] hover:border-amber-400/60 rounded block">
            <span class="text-[10px] text-[var(--fg-dim)] block">故障排障篇</span>
            <span class="text-emerald-400 font-bold text-xs md:text-sm">关代理断网一键修</span>
          </a>
          <a href="#section-ai-streaming" class="p-3 bg-black/40 border border-[var(--border-dim)] hover:border-amber-400/60 rounded block">
            <span class="text-[10px] text-[var(--fg-dim)] block">AI 与流媒体</span>
            <span class="text-purple-400 font-bold text-xs md:text-sm">解决 1020 报错</span>
          </a>
          <a href="#section-recommendation" class="p-3 bg-black/40 border border-[var(--border-dim)] hover:border-amber-400/60 rounded block">
            <span class="text-[10px] text-[var(--fg-dim)] block">省心推荐</span>
            <span class="text-amber-400 font-bold text-xs md:text-sm">光速云 IEPL 专线</span>
          </a>
        </div>
      </header>

      <!-- 核心分类 Hub 入口矩阵 -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>[01]</span>
            <span>三大核心分类问答 Hub 与长尾专题文献</span>
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">点击进入分类专区</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {FAQ_CATEGORIES.map((cat) => {
            const count = FAQ_ARTICLES.filter((a) => a.category === cat.slug).length;
            return (
              <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 rounded space-y-3 hover:border-amber-400/60 transition-colors flex flex-col justify-between">
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-3xl">{cat.icon}</span>
                    <span class="text-[10px] text-amber-400 bg-amber-950/40 border border-amber-800/40 px-2 py-0.5 rounded font-mono">
                      {count} 篇精选
                    </span>
                  </div>
                  <h3 class="text-base font-bold text-white">
                    <a href={`/faq/${cat.slug}`} class="hover:underline">{cat.name}</a>
                  </h3>
                  <p class="text-xs text-[var(--fg-muted)] leading-relaxed font-sans">
                    {cat.description}
                  </p>
                </div>
                <div class="pt-2 border-t border-[var(--border-dim)] flex items-center justify-between">
                  <span class="text-[11px] text-[var(--fg-dim)] font-mono">{cat.tagline}</span>
                  <a href={`/faq/${cat.slug}`} class="text-xs text-amber-400 hover:underline font-bold">
                    浏览专区 &gt;&gt;
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <!-- 长尾精选问答深度文章直达 -->
        <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 rounded space-y-3">
          <span class="text-xs font-bold text-amber-300 block">📚 重点精选长尾实战解答文献：</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            {FAQ_ARTICLES.map((art) => (
              <a href={`/faq/${art.category}/${art.slug}`} class="p-2.5 bg-[var(--bg-main)] hover:bg-white/5 border border-[var(--border-dim)] hover:border-amber-400/40 rounded flex items-center justify-between gap-2 group">
                <span class="text-[var(--fg-main)] group-hover:text-amber-300 truncate">{art.question}</span>
                <span class="text-[10px] text-amber-400 border border-amber-900/60 px-1.5 py-0.2 shrink-0">{art.category}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 专著级系统性技术问答正文长文 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-8 rounded space-y-12 font-sans leading-relaxed text-sm">
        
        <!-- 模块一：底层物理链路与专线机房篇 -->
        <div id="section-protocols" class="space-y-6">
          <div class="border-b border-[var(--border-dim)] pb-2 flex items-center justify-between">
            <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono flex items-center gap-2">
              <span>[02]</span>
              <span>模块一：物理链路与专线机房架构篇（IEPL / IPLC / BGP / 直连）</span>
            </h2>
            <span class="text-xs text-[var(--fg-dim)]">共 6 问</span>
          </div>

          <div class="space-y-4 text-xs">
            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q1-1：IEPL 与 IPLC 物理专线到底是什么？为什么说它们永远不被封锁？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【底层本质解答】：
                IPLC（International Private Leased Circuit，国际私有租用线路）与 IEPL（International Ethernet Private Line，国际以太网私网专线）在物理层面上是电信运营商在两地机房之间拉设的一根“点对点内网以太网光纤通道”。
                传统翻墙需要把数据包发往国内公网、经过层层国际出口网关并接受深度包检测（DPI）。而 IEPL 专线完全脱离公网，你的数据包在进入境内机房入口后，直接被封装进运营商内部的二层以太网帧中，通过海底物理光缆直达香港或日本对端机房。由于整个物理传输链路根本不路过公网国际防火墙，因此从数学和物理原理上实现了<strong>0% 阻断、0% 敏感时期封锁</strong>。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q1-2：IEPL 和 IPLC 有什么技术差别？为什么现在主流机场以 IEPL 为主？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【技术对比解答】：
                IPLC 是基于传统 SDH/SONET 物理时分复用架构的早期专线，调度灵活性较差、起租带宽费用极度高昂。
                而 IEPL 是基于现代以太网协议标准的增强型物理专线，支持更灵活的突发带宽弹性扩容（Jumbo Frame 支持达 9000 字节），并具备多路径自动物理保护倒换能力。对于现代高并发视频与大规模数据传输而言，IEPL 在保持 0 丢包的同时具备更好的成本效益，因此 2026 年一线高品质机场（如光速云）全部以企业级 IEPL 作为核心骨干基石。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q1-3：什么是 BGP 入口？单线入口与多线 BGP 入口差距有多大？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【网络工程解答】：
                BGP（Border Gateway Protocol，边界网关协议）入口机房同时接入了中国电信、中国联通、中国移动、教育网等国内所有主流运营商的骨干核心网。
                如果机场使用的是廉价的“单线电信入口”，联通和移动用户在连接时必须发生跨运营商跨网结算跳转，导致延迟剧烈增加 40ms 以上并产生丢包。而具备全 BGP 入口的机场，电信走电信、联通走联通、移动走移动，自动就近接入运营商骨干交换中心，实现全国任意地区客户端进入专线机房的延迟均控制在 15ms 以内的极致水准。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q1-4：公网中继（Relay）机场为什么在晚高峰经常大面积卡顿？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【瓶颈成因解答】：
                公网中继机场虽然也使用了境内入口服务器，但境内服务器与境外落地服务器之间并没有昂贵的物理专线，而是通过普通的 163/169 国际公网进行数据转发。每到晚高峰 20:00 至 23:00，全中国民用宽带国际出口带宽发生严重拥塞，运营商的公网网关启动严格的 QoS 丢包惩罚机制。公网中继节点丢包率往往瞬间飙升至 50% 以上，在客户端中直观表现为测速全红、看视频频繁缓冲。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q1-5：为什么机场节点列表中通常有 0.1x、1.0x、3.0x 不同的倍率标注？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【计费机制解答】：
                倍率是机场根据后端不同物理线路的真实采购成本设定的流量消耗乘数：
                • <strong>0.1x / 0.2x 节点：</strong> 属于超低倍率线路，消耗 10GB 实际流量只扣除账户 1GB 配额，通常为普通公网直连链路，适合下载冷门超大文件；
                • <strong>1.0x 节点：</strong> 标准企业级 IEPL 专线，消耗与扣除 1:1，性能稳定，是日常主力首选；
                • <strong>3.0x / 5.0x 节点：</strong> 通常配备了极度昂贵的海外独享原生住宅 IP、或极端低延迟定制专线，适合跨境电商核心运营或关键跨国视频会议。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q1-6：很多机场标榜自己拥有“千兆内网专线”，普通用户如何识别真伪？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【技术鉴别解答】：
                在晚高峰 21:00 使用客户端运行基于连续 ICMP/TCP Ping 的网络抖动测试：
                真正的 IEPL 内网专线在发送 500 个探测包时，丢包率（Packet Loss）绝对为 0.0%，且延迟波动（Jitter）不会超过 3ms；而假专线（即公网伪装中继）在晚高峰的丢包率一定会发生突刺跳变至 10% 以上，延迟也会在 60ms 到 300ms 之间大幅剧烈漂移。
              </p>
            </div>
          </div>
        </div>

        <!-- 模块二：协议加密与防审查篇 -->
        <div class="space-y-6">
          <div class="border-b border-[var(--border-dim)] pb-2 flex items-center justify-between">
            <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono flex items-center gap-2">
              <span>[03]</span>
              <span>模块二：传输协议与防主动探测篇（VLESS / Reality / Trojan / Hysteria）</span>
            </h2>
            <span class="text-xs text-[var(--fg-dim)]">共 6 问</span>
          </div>

          <div class="space-y-4 text-xs">
            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q2-1：VLESS-Reality 协议到底强在哪里？为什么它被称为新一代反探测天花板？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【密码学机理解答】：
                传统的加密协议（如 Shadowsocks 或早期 VMess）自身带有非标准的握手数据包头，现代机器学习算法可以轻易识别出其熵值特征；而传统 Trojan 协议虽然伪装成 HTTPS，但必须在服务器上申请并配置真实的 SSL 证书，容易被证书日志与域名扫描锁定。
                Reality 技术则做到了极致的“真伪难辨”：它直接借用微软、苹果、雅虎等全球权威大厂的真实网站证书进行 TLS 握手。中间人嗅探设备发起的主动探测探测扫描获取到的证书指纹与真实境外合规大厂毫无二致，真正做到了在网络层面的完美隐身。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q2-2：Hysteria 2（歇斯底里）基于 UDP，为什么在部分网络下反而极慢甚至断流？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【UDP QoS 限速成因】：
                Hysteria 2 基于 QUIC/UDP 协议，其暴力发包算法在弱网丢包环境下确实能强行拉高速度。然而，在部分地区的中国电信或长城宽带网络中，运营商对 UDP 53（DNS）和 UDP 123（NTP）以外的非常规 UDP 端口实施了极严苛的 QoS 限制策略。一旦检测到某个 UDP 端口发生持续大流量传输，运营商的交换机会强制进行每秒 80% 的限速丢包，导致 Hysteria 发生灾难级的断流；此时切换回基于 TCP 的 Trojan 或专线协议反而能够满血复活。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q2-3：为什么现在越来越少的机场继续提供原版 Shadowsocks 节点？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【历史技术淘汰解答】：
                原版 Shadowsocks 缺乏现代 TLS 伪装外壳。公网直连环境下，随着 GFW 部署的主动探测系统持续升级，未经过专线隔离的 Shadowsocks 节点在产生大流量后，数十分钟内其服务器端口就会被精准封锁。目前仅有像【光速云】这样拥有全程 IEPL 内网物理隔离专线的服务商，才能安全高效地使用定制优化的 SS-AEAD 协议（因为专线内部无需复杂的 TLS 握手计算开销，能将传输延迟压缩至物理理论极限）。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q2-4：什么是主动探测（Active Probing）？它是如何封杀海外 VPS 的？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【网络攻防机制解答】：
                当防火墙检测到境内 IP 持续向境外某个未知端口发送具有加密特征的异常 TCP 流量时，防火墙的后台系统会自动调用全国各地的分布式扫描节点，伪装成普通客户端向该境外服务器的该端口主动发起特定探针包。如果服务器返回了代理软件特有的回包响应、或者没有返回正常的 Web 网页，防火墙立即在数秒内向运营商骨干路由器下发阻断策略，将该 IP:端口彻底打入黑名单。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-[var(--border-dim)] rounded space-y-2">
              <strong class="text-amber-300 block text-sm">Q2-5：专线机场和协议抗封锁能力之间有什么深层互补关系？</strong>
              <p class="text-[var(--fg-muted)] leading-relaxed">
                【架构协同解答】：
                “好协议管公网，好专线管内网”。对于公网直连节点，协议的伪装能力（如 Reality）决定了其寿命；但对于真正的 IEPL 专线，物理光纤本身已经把审查设备完全隔绝在门外。因此在专线内部，重点不是研究如何伪装，而是追求极简的报文封装与最低的加解密计算开销，从而释放出高达 10Gbps 的吞吐能力与低于 1ms 的处理延迟。
              </p>
            </div>
          </div>
        </div>

