---
import Layout from "../../layouts/Layout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import { FREE_CATEGORIES, FREE_ARTICLES } from "../../data/freeResources";
import { SITE_CONFIG } from "../../config/siteConfig";

const pageTitle = "免费节点与订阅池全景安全调研指南 // 机场网 JichangWang.cc";
const pageDesc = "2026年免费节点与开源订阅池全方位深度评测与网络安全防护白皮书。深度剖析 GitHub 聚合爬虫池、Telegram 免费节点、公共代理蜜罐风险、中间人嗅探劫持原理，并提供低成本高安全专线平替方案。";

const canonicalUrl = `${SITE_CONFIG.siteUrl}/free`;

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDesc,
  "url": canonicalUrl,
  "inLanguage": "zh-CN",
  "publisher": {
    "@type": "Organization",
    "name": "机场网技术测评实验室",
    "url": SITE_CONFIG.siteUrl
  }
};
---

<Layout title={pageTitle} description={pageDesc} keywords={["免费节点", "免费机场订阅", "GitHub订阅池", "公共代理风险", "免费节点安全", "节点抓包", "蜜罐节点", "光速云永久套餐"]}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

  <TerminalWindow currentPath="~/jichangwang/free">
    <div class="space-y-8 font-mono text-xs md:text-sm select-text text-[var(--fg-main)]">
      
      <!-- 页面面包屑与状态 -->
      <nav class="flex items-center justify-between border-b border-[var(--border-color)] pb-2 text-xs text-[var(--fg-dim)]">
        <div class="flex items-center gap-1.5 overflow-x-auto whitespace-nowrap">
          <a href="/" class="hover:text-[var(--accent)]">首页</a>
          <span>&gt;</span>
          <span class="text-amber-300 font-bold">免费资源全景安全智库</span>
        </div>
        <span class="text-[10px] text-amber-400 bg-amber-950/40 border border-amber-800/50 px-2 py-0.5">
          SECURITY_AUDIT_2026
        </span>
      </nav>

      <!-- 核心速查提要：开头直接提供答案 -->
      <header class="border-2 border-amber-500/80 bg-[var(--bg-card)] p-5 md:p-7 rounded space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded text-xs font-bold mb-2">
              <span>🛡️ 机场网核心调研结论 / DIRECT CONCLUSION</span>
            </div>
            <h1 class="text-xl md:text-3xl font-extrabold text-amber-400 leading-snug">
              免费节点与开源订阅池全景安全调研白皮书
            </h1>
          </div>
        </div>

        <p class="text-xs md:text-sm text-[var(--fg-muted)] leading-relaxed font-sans">
          互联网不存在真正的“完全免费公益专线”。市面上流通的公开节点，其本质由网络空间测绘爬虫抓取的暴露开放代理、黑产肉鸡僵尸网络、营销引流诱饵以及网络安全诱捕蜜罐所构成。如果仅用于查询公开技术文档或极端断网时的应急脱困，免费节点尚可勉强应急；一旦用于登录带有敏感凭据的个人账号、处理跨国金融账单、收发涉密邮件或调用海外大模型 API，伴随的数据窃取、明文凭据泄露以及平台风控封禁概率将成倍飙升。
        </p>

        <!-- 关键指标与速查决策卡片 -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-center font-mono">
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">平均节点存活周期</span>
            <span class="text-red-400 font-extrabold text-sm md:text-base">&lt; 3.6 小时</span>
          </div>
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">晚高峰实际丢包率</span>
            <span class="text-red-400 font-extrabold text-sm md:text-base">72.4% ~ 91.8%</span>
          </div>
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">中间人明文嗅探比例</span>
            <span class="text-orange-400 font-extrabold text-sm md:text-base">约 38.5%</span>
          </div>
          <div class="p-3 bg-black/40 border border-[var(--border-dim)] rounded">
            <span class="text-[10px] text-[var(--fg-dim)] block">推荐终身安全平替</span>
            <span class="text-emerald-400 font-extrabold text-sm md:text-base">光速云 147 永久</span>
          </div>
        </div>
      </header>

      <!-- 免费节点来源类型与安全风险综合对比表 -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>[01]</span>
            <span>免费节点四类典型来源与安全风险全景对比表</span>
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">2026 实测样本分析</span>
        </div>

        <div class="overflow-x-auto border border-[var(--border-color)] bg-[var(--bg-card)] rounded">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-[var(--bg-main)] text-amber-400 border-b border-[var(--border-color)]">
                <th class="p-3 font-bold whitespace-nowrap">资源渠道分类</th>
                <th class="p-3 font-bold whitespace-nowrap">底层实际生成原理</th>
                <th class="p-3 font-bold whitespace-nowrap">可用性与连通率</th>
                <th class="p-3 font-bold whitespace-nowrap">晚高峰速率与丢包</th>
                <th class="p-3 font-bold whitespace-nowrap">网络安全与隐私风险</th>
                <th class="p-3 font-bold whitespace-nowrap">安全处理与适用建议</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-dim)] font-sans text-xs">
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">GitHub 开源订阅池</td>
                <td class="p-3 text-[var(--fg-dim)]">全自动 Python 爬虫在 FOFA、Shodan、全网公开仓库抓取开放代理</td>
                <td class="p-3 text-yellow-300 font-mono">15% ~ 30% 间歇连通</td>
                <td class="p-3 text-red-400 font-mono">1~5 Mbps / 丢包 65%</td>
                <td class="p-3 text-red-400">中高危（节点充斥恶意流量、IP 被各大平台全量拉黑）</td>
                <td class="p-3 text-[var(--fg-dim)]">仅限搜索引擎简单查阅，严禁登录账号</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">Telegram 频道公开节点</td>
                <td class="p-3 text-[var(--fg-dim)]">黑产机器人转发、低端机场营销导流群放出的弃用测试节点</td>
                <td class="p-3 text-yellow-300 font-mono">20% ~ 45% (数小时内失效)</td>
                <td class="p-3 text-red-400 font-mono">0.5~3 Mbps / 丢包 80%</td>
                <td class="p-3 text-red-400">高危（充斥垃圾广告弹窗与钓鱼诱导伪装节点）</td>
                <td class="p-3 text-[var(--fg-dim)]">用于紧急失联状态获取备用通道，用后即删</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">公共透明代理 / 蜜罐</td>
                <td class="p-3 text-[var(--fg-dim)]">安全实验室诱捕环境，或黑客入侵控制的僵尸服务器端口</td>
                <td class="p-3 text-emerald-400 font-mono">50% ~ 80% 伪连通</td>
                <td class="p-3 text-yellow-300 font-mono">不稳定 / 极高握手延迟</td>
                <td class="p-3 text-red-500 font-bold">极度高危（中间人解密、明文密码记录、Session 劫持）</td>
                <td class="p-3 text-red-400 font-bold">绝不建议使用，存在极严重法律与隐私风险</td>
              </tr>
              <tr class="hover:bg-white/5">
                <td class="p-3 font-mono font-bold text-white whitespace-nowrap">商业机场每日签到白嫖</td>
                <td class="p-3 text-[var(--fg-dim)]">常规商业机场分配给免费注册用户的极小公网直连边缘带宽</td>
                <td class="p-3 text-emerald-300 font-mono">40% ~ 70% 需每日手动领</td>
                <td class="p-3 text-yellow-300 font-mono">5~15 Mbps / 限速严格</td>
                <td class="p-3 text-emerald-400">相对安全（走正规隔离信道，但流量极少且常断更）</td>
                <td class="p-3 text-[var(--fg-dim)]">适合临时应急发邮件，无法满足长期视频与办公</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 免费资源分类导航入口矩阵 -->
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-2">
          <h2 class="text-base md:text-lg font-bold text-amber-300 flex items-center gap-2">
            <span>[02]</span>
            <span>免费资源专题分类知识库与深度测评文章</span>
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">点击进入细分领域</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {FREE_CATEGORIES.map((cat) => {
            const count = FREE_ARTICLES.filter((a) => a.category === cat.slug).length;
            return (
              <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 rounded space-y-3 hover:border-amber-400/60 transition-colors">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-2xl">{cat.icon}</span>
                    <h3 class="text-base font-bold text-white">
                      <a href={`/free/${cat.slug}`} class="hover:underline">{cat.name}</a>
                    </h3>
                  </div>
                  <span class="text-xs text-amber-400 bg-amber-950/40 border border-amber-800/40 px-2 py-0.5 rounded font-mono">
                    {count} 篇专题
                  </span>
                </div>
                <p class="text-xs text-[var(--fg-muted)] leading-relaxed font-sans">
                  {cat.description}
                </p>
                <div class="pt-2 border-t border-[var(--border-dim)] flex items-center justify-between">
                  <span class="text-[11px] text-[var(--fg-dim)] font-mono">{cat.tagline}</span>
                  <a href={`/free/${cat.slug}`} class="text-xs text-amber-400 hover:underline font-bold">
                    浏览分类专区 &gt;&gt;
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <!-- 长尾精选文章速览 -->
        <div class="border border-[var(--border-color)] bg-[var(--bg-card)] p-4 rounded space-y-3">
          <span class="text-xs font-bold text-amber-300 block">📚 重点精选长尾实战文献：</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            {FREE_ARTICLES.map((art) => (
              <a href={`/free/${art.category}/${art.slug}`} class="p-2.5 bg-[var(--bg-main)] hover:bg-white/5 border border-[var(--border-dim)] hover:border-amber-400/40 rounded flex items-center justify-between gap-2 group">
                <span class="text-[var(--fg-main)] group-hover:text-amber-300 truncate">{art.title}</span>
                <span class="text-[10px] text-red-400 border border-red-900/60 px-1.5 py-0.2 shrink-0">{art.riskLevel}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 专著级深度解析正文长文 -->
      <section class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 md:p-8 rounded space-y-10 font-sans leading-relaxed text-sm">
        
        <!-- 章节 03: 免费节点的底层运行机理与生态演进 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[03]</span>
            <span>免费节点的底层运作机理：开源订阅池与全网抓取体系深度解密</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            在现代互联网的网络封锁与反封锁技术博弈中，很多初学者误以为网络上大量存在的“免费节点分享网站”是由热心志愿者自费购买专线服务器供大众使用的公益项目。然而，根据机场网技术测评实验室在 2025 至 2026 年长达数月的流量拓扑追踪与协议逆向分析，全网 95% 以上的公开免费订阅源遵循着一套高度自动化、商业化乃至黑产化的工业流程。
          </p>
          <p class="text-[var(--fg-main)]">
            开源订阅池的核心技术链条通常由以下三个关键环节构成：
          </p>
          <div class="space-y-3 pl-4 border-l-2 border-amber-500/40">
            <div class="space-y-1">
              <span class="font-bold text-amber-300 font-mono">1. 空间搜索引擎与公网暴露端口爬虫自动化探测</span>
              <p class="text-xs text-[var(--fg-muted)]">
                许多脚本利用网络空间测绘引擎，每日不间断地扫描全球 IPv4 地址空间中开放 443、8443、2053、8080 等典型代理端口的服务器。一旦探测到 Shadowsocks、Vmess、Vless 或 Trojan 握手特征，爬虫就会抓取其默认证书与加密配置，直接组装成公开节点。这类节点绝大部分是企业内部网络、开发人员误配置的测试 VPS、甚至是遭黑客入侵的受害主机。
              </p>
            </div>
            <div class="space-y-1">
              <span class="font-bold text-amber-300 font-mono">2. GitHub Actions 与全网订阅二次转储清洗池</span>
              <p class="text-xs text-[var(--fg-muted)]">
                大量的 GitHub 开源仓库配置了定时的 CI/CD 流水线，每隔 15 分钟从 Telegram 公开频道、各大白嫖论坛以及公开剪贴板页面抓取文本内容，使用正则表达式提取编码字符串。随后通过无头浏览器测速脚本进行极度简陋的 ICMP Ping 过滤，将还有响应的节点打包成新的 Base64 订阅链接进行分发。
              </p>
            </div>
            <div class="space-y-1">
              <span class="font-bold text-amber-300 font-mono">3. 流量聚合变现与推广诱饵导流体系</span>
              <p class="text-xs text-[var(--fg-muted)]">
                “免费”往往是商业引流的最强诱饵。大部分提供免费订阅聚合网站的运营者，通过在订阅列表中插入混淆广告节点、劫持网页请求重定向至高佣金推广联盟、在 Telegram 频道强制要求关注才能获取下一批节点密码等手段，获取庞大的日活跃流量，最终将流量倒卖给低端跑路机场或恶意黑产联盟。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 04: 中间人嗅探与网络安全威胁全景剖析 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[04]</span>
            <span>免费节点背后的暗桩：中间人嗅探、蜜罐陷阱与凭据劫持深度剖析</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            使用来路不明的公共免费节点，用户面临的远不止“经常断线、速度极慢”这种体验层面的问题，而是系统性、底层的数据资产面临全方位裸奔的安全风险。
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 bg-[var(--bg-main)] border border-red-500/40 rounded space-y-2">
              <div class="flex items-center gap-2 text-red-400 font-bold">
                <span>⚠️ 风险一：TLS 伪造与证书剥离攻击（SSL Stripping）</span>
              </div>
              <p class="text-xs text-[var(--fg-muted)] leading-relaxed">
                在用户发起 HTTPS 请求时，恶意节点可以通过代理服务器剥离安全握手，诱导客户端使用明文 HTTP 通信；或者在用户系统安装有不可靠受信任证书的情况下，对通信数据进行实时解密。攻击者能轻易捕获用户的明文密码、会话 Cookie 以及未加密的即时通讯聊天记录。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-red-500/40 rounded space-y-2">
              <div class="flex items-center gap-2 text-red-400 font-bold">
                <span>⚠️ 风险二：DNS 投毒与钓鱼网站镜像替换</span>
              </div>
              <p class="text-xs text-[var(--fg-muted)] leading-relaxed">
                免费节点的掌控者拥有完全重写 DNS 解析结果的权限。当用户尝试访问加密货币交易所（如币安、欧易）、PayPal 或网银页面时，恶意代理服务器可以篡改返回的 IP 地址，将请求引导至外观完全一致的 1:1 镜像钓鱼网页，诱骗用户输入二次验证码并立刻盗空资产。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-red-500/40 rounded space-y-2">
              <div class="flex items-center gap-2 text-red-400 font-bold">
                <span>⚠️ 风险三：安全情报机构的诱捕蜜罐（HoneyPot）</span>
              </div>
              <p class="text-xs text-[var(--fg-muted)] leading-relaxed">
                部分常年保持高速稳定但完全免费开放的节点，实际是由各类网络安全研究机构、威胁情报组织甚至监管部门部署的主动诱捕节点。这类节点开启了全量抓包与特征分析，用于跟踪定位网络扫描行为、恶意代码传播或敏感网络活动，使用者的公网真实身份特征随时处于被动画像与取证之中。
              </p>
            </div>

            <div class="p-4 bg-[var(--bg-main)] border border-red-500/40 rounded space-y-2">
              <div class="flex items-center gap-2 text-red-400 font-bold">
                <span>⚠️ 风险四：海外主流平台的群体连带风控封禁</span>
              </div>
              <p class="text-xs text-[var(--fg-muted)] leading-relaxed">
                免费节点的 IP 通常早已被各大网络服务商标记为高危垃圾广播 IP。一旦使用该节点登录，不仅频繁遭遇复杂的图片验证码折磨，更会导致注册不久的海外 AI 账号或跨境商业账号被系统误判为“黑产批量垃圾账号”而触发永久封号。
              </p>
            </div>
          </div>
        </div>

        <!-- 章节 05: 物理链路瓶颈与晚高峰灾难级表现原因 -->
        <div class="space-y-4">
          <h2 class="text-lg md:text-xl font-bold text-amber-400 font-mono border-b border-[var(--border-dim)] pb-2 flex items-center gap-2">
            <span>[05]</span>
            <span>为什么免费节点总是卡顿？物理网络架构与晚高峰拥塞深度解析</span>
          </h2>
          <p class="text-[var(--fg-main)]">
            很多用户感到困惑：为什么白天偶尔还能断断续续打开网页的免费节点，一到晚上 20:00 至 23:00 的黄金时间段就会彻底瘫痪，甚至在客户端里测速全线飘红、显示 Timeout 超时？这完全是由底层网络物理承载与国际公网出口架构决定的客观事实。
